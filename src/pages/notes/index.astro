---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";

const notes = (await getCollection("notes"))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const empty = notes.length === 0;
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base
  title="Notes"
  description="Writing on mobile engineering — Flutter, native bridges, and shipping at scale."
  noindex={empty}
>
  <section class="container-page section-y">
    <div class="eyebrow mb-4">Notes</div>
    <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight leading-[1.05]">
      Writing<span class="text-accent">.</span>
    </h1>

    {empty ? (
      <p class="mt-8 max-w-prose font-serif text-lg text-muted leading-relaxed">
        Notes are on the way — short pieces on mobile architecture, Flutter performance,
        and native bridges. Check back soon.
      </p>
    ) : (
      <ul class="mt-12 max-w-prose space-y-8">
        {notes.map((n) => (
          <li>
            <a href={`/notes/${n.slug}`} class="group block">
              <div class="eyebrow text-muted">{fmtDate(n.data.date)}</div>
              <h2 class="mt-1.5 font-display text-2xl font-semibold tracking-tight text-text group-hover:text-accent transition-colors">
                {n.data.title}
              </h2>
              <p class="mt-1 font-serif text-muted">{n.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
