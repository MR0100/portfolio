---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "~/layouts/Base.astro";

export async function getStaticPaths() {
  const notes = (await getCollection("notes")).filter((n) => !n.data.draft);
  return notes.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base title={entry.data.title} description={entry.data.description} type="article">
  <article class="container-page section-y max-w-prose">
    <a href="/notes" class="eyebrow text-muted hover:text-accent transition-colors">← Notes</a>
    <h1 class="mt-5 font-display text-4xl md:text-5xl font-semibold tracking-tight leading-tight">
      {entry.data.title}
    </h1>
    <div class="mt-3 eyebrow text-muted">
      {fmtDate(entry.data.date)}
      {entry.data.updated && <> · updated {fmtDate(entry.data.updated)}</>}
    </div>

    <div class="note-body mt-8 font-serif text-lg leading-relaxed">
      <Content />
    </div>
  </article>

  <style>
    /* Minimal prose styling (no @tailwindcss/typography dep) — themed tokens. */
    .note-body :global(h2) { font-family: Fraunces, ui-serif, serif; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; margin: 2.5rem 0 0.75rem; }
    .note-body :global(h3) { font-family: Fraunces, ui-serif, serif; font-size: 1.25rem; font-weight: 600; margin: 2rem 0 0.5rem; }
    .note-body :global(p) { margin-bottom: 1.25rem; color: rgb(var(--text)); }
    .note-body :global(a) { color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 4px; }
    .note-body :global(ul), .note-body :global(ol) { padding-left: 1.5rem; margin-bottom: 1.25rem; }
    .note-body :global(ul) { list-style: disc; }
    .note-body :global(ol) { list-style: decimal; }
    .note-body :global(li) { margin-bottom: 0.375rem; }
    .note-body :global(blockquote) { border-left: 2px solid rgb(var(--accent)); padding-left: 1rem; color: rgb(var(--muted)); font-style: italic; margin: 1.5rem 0; }
    .note-body :global(code) { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.9em; background: rgb(var(--surface)); padding: 0.1rem 0.35rem; border-radius: 4px; }
    .note-body :global(pre) { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.875rem; background: rgb(var(--surface)); padding: 1rem; border-radius: 8px; overflow-x: auto; margin-bottom: 1.25rem; }
    .note-body :global(pre code) { background: none; padding: 0; }
  </style>
</Base>
