---
import { getCollection } from "astro:content";
import { profile, experience, education, certifications, openSource, talks, skillGroups } from "~/data/profile";

// Pull featured projects from the work content collection. ATS-safe rule:
// keep this list TIGHT — only load-bearing, recognizable work. The T01 guide
// says skip projects at 5+ YOE unless distinctive; these 6 featured entries
// are shipped products, so they earn their place.
const featured = (await getCollection("work"))
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// ATS-safe print view — A4 redesign with stronger structure.
//
// Page geometry — A4 (210mm × 297mm), 15mm top/bottom × 18mm left/right margins
// for ~174mm × 267mm of body area. 1-page target for ≤7 YOE (T01 rule).
//
// ATS rules preserved (T01 Resume Fundamentals):
//   • Single column · Workday / Lever / iCIMS / Greenhouse friendly
//   • System fonts (Calibri / Segoe UI / Arial chain) — no web fonts loaded
//   • Standard section labels (Summary · Experience · Skills · Education)
//   • No icons / photos / multi-column / decorative graphics
//   • Plain-text URLs alongside any hyperlinks
//   • Contact info inside body (Workday drops headers/footers)
//   • Dates in "Month YYYY — Month YYYY" format
//
// Design polish (still 100% parseable):
//   • Mono palette — black / dark / gray / white only, no chromatic colors
//   • Two-column flush alignment for company/period + title/location pairs
//   • Double-rule editorial mark under name (thick + thin, both pure black)
//   • Section headings: solid black accent bar + extending hairline rule
//   • Skills: top + bottom solid black bounds, hairline gray between rows
//   • Tight, deliberate vertical rhythm built around a 12pt baseline grid feel
//   • Page footer mirrors the under-name treatment for editorial unity

const flatSkills = skillGroups.map((g) => ({
  title: g.title,
  list: g.skills.map((s) => s.name).join(", "),
}));

const linkedinPlain = "linkedin.com/in/mitul-vaghasiya";
const githubPlain = "github.com/MR0100";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} — Resume</title>

    <!-- Theme bootstrap — mirrors src/layouts/Base.astro so the preview
         chrome follows the website's theme toggle (localStorage "theme")
         instead of the OS-level prefers-color-scheme. Runs synchronously
         BEFORE first paint to avoid a flash of the wrong mode. -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          const mode = saved || system;
          if (mode === "dark") document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="page">
      <!-- ── Header ── -->
      <header class="hdr">
        <h1 class="hdr-name">{profile.name}</h1>
        <div class="hdr-role">{profile.headline}</div>
        <!-- Double-rule under name — editorial mono treatment -->
        <div class="hdr-rule" aria-hidden="true">
          <span class="hdr-rule-thick"></span>
          <span class="hdr-rule-thin"></span>
        </div>

        <div class="hdr-rows">
          <!-- Row 1 — Location + Email (left) · Phone/Notice/etc placeholder (right) -->
          <div class="hdr-row">
            <span class="hdr-cell">
              <span class="hdr-label">Location</span>
              <span class="hdr-value">{profile.location}</span>
            </span>
            <span class="hdr-cell hdr-cell--right">
              <span class="hdr-label">Email</span>
              <a class="hdr-value" href={`mailto:${profile.email}`}>{profile.email}</a>
            </span>
          </div>
          <!-- Row 2 — LinkedIn (left) · GitHub (right) -->
          <div class="hdr-row">
            <span class="hdr-cell">
              <span class="hdr-label">LinkedIn</span>
              <a class="hdr-value" href={profile.socials.linkedin}>{linkedinPlain}</a>
            </span>
            <span class="hdr-cell hdr-cell--right">
              <span class="hdr-label">GitHub</span>
              <a class="hdr-value" href={profile.socials.github}>{githubPlain}</a>
            </span>
          </div>
          <!-- Row 3 — Open to + Notice + Languages, single row of facts -->
          <div class="hdr-row hdr-row--meta">
            <span class="hdr-meta-cell">
              <span class="hdr-label">Open to</span>
              <span class="hdr-value">Senior IC · Mobile Lead · Architecture</span>
            </span>
            <span class="hdr-meta-cell">
              <span class="hdr-label">Notice</span>
              <span class="hdr-value">{profile.noticePeriod}</span>
            </span>
            <span class="hdr-meta-cell">
              <span class="hdr-label">Languages</span>
              <span class="hdr-value">{profile.languagesSpoken.join(" / ")}</span>
            </span>
          </div>
        </div>
      </header>

      <!-- ── Summary ── -->
      <section>
        <h2><span class="h2-bar"></span><span class="h2-text">Summary</span><span class="h2-rule"></span></h2>
        <p class="summary">{profile.bioShort}</p>
      </section>

      <!-- ── Experience ── -->
      <section>
        <h2><span class="h2-bar"></span><span class="h2-text">Experience</span><span class="h2-rule"></span></h2>

        {experience.map((role, idx) => (
          <div class={`role ${idx === 0 ? "role--first" : ""}`}>
            <!-- Row 1: Company (flush left) · Period (flush right) -->
            <div class="role-row">
              <span class="role-company">{role.company}</span>
              <span class="role-period">{role.period}</span>
            </div>
            <!-- Row 2: Title (flush left) · Location (flush right) -->
            <div class="role-row role-row--sub">
              <span class="role-title">{role.title}</span>
              <span class="role-loc">{role.location}</span>
            </div>
            <ul class="bullets">
              {role.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        ))}
      </section>

      <!-- ── Projects ── -->
      {featured.length > 0 && (
        <section>
          <h2><span class="h2-bar"></span><span class="h2-text">Selected Projects</span><span class="h2-rule"></span></h2>
          {featured.map((p) => {
            const stackTop = p.data.stack.slice(0, 5).join(", ");
            const stackMore = p.data.stack.length > 5 ? ` (+${p.data.stack.length - 5} more)` : "";
            return (
              <div class="project">
                <div class="project-row">
                  <span class="project-name">{p.data.title}</span>
                  <span class="project-period">{p.data.period}</span>
                </div>
                <div class="project-row project-row--sub">
                  <span class="project-meta">
                    <span class="project-role">{p.data.role}</span>
                    <span class="project-sep"> · </span>
                    <span class="project-stack">{stackTop}{stackMore}</span>
                  </span>
                  <span class="project-employer">{p.data.employer}</span>
                </div>
                <p class="project-line">{p.data.oneLiner}</p>
              </div>
            );
          })}
        </section>
      )}

      <!-- ── Skills ── -->
      <section class="tight">
        <h2><span class="h2-bar"></span><span class="h2-text">Skills</span><span class="h2-rule"></span></h2>
        <dl class="skills">
          {flatSkills.map((g) => (
            <div class="skill-row">
              <dt>{g.title}</dt>
              <dd>{g.list}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ── Education ── -->
      <section class="tight">
        <h2><span class="h2-bar"></span><span class="h2-text">Education</span><span class="h2-rule"></span></h2>
        {education.map((edu) => (
          <div class="role">
            <div class="role-row">
              <span class="role-company">{edu.institution}</span>
              <span class="role-period">{edu.period}</span>
            </div>
            <div class="role-row role-row--sub">
              <span class="role-title">{edu.degree}</span>
              <span class="role-loc">{edu.location}</span>
            </div>
          </div>
        ))}
      </section>

      <!-- ── Certifications ── -->
      {certifications.length > 0 && (
        <section class="tight">
          <h2><span class="h2-bar"></span><span class="h2-text">Certifications</span><span class="h2-rule"></span></h2>
          {certifications.map((c) => (
            <div class="entry">
              <div class="entry-row">
                <span class="entry-title">{c.title}</span>
                <span class="entry-side">{c.issuer}</span>
              </div>
              {c.note && <div class="entry-body">{c.note}</div>}
              {c.url && <div class="entry-url">{c.url}</div>}
            </div>
          ))}
        </section>
      )}

      <!-- ── Open Source (only when populated) ── -->
      {openSource.length > 0 && (
        <section>
          <h2><span class="h2-bar"></span><span class="h2-text">Open Source</span><span class="h2-rule"></span></h2>
          {openSource.map((o) => (
            <div class="entry">
              <div class="entry-row">
                <span class="entry-title">{o.title}{o.badge ? ` (${o.badge})` : ""}</span>
                <span class="entry-side">{o.repo}</span>
              </div>
              <div class="entry-body">{o.detail}</div>
              <div class="entry-url">{o.url}</div>
            </div>
          ))}
        </section>
      )}

      <!-- ── Talks (only when populated) ── -->
      {talks.length > 0 && (
        <section>
          <h2><span class="h2-bar"></span><span class="h2-text">Talks &amp; Writing</span><span class="h2-rule"></span></h2>
          {talks.map((t) => (
            <div class="entry">
              <div class="entry-row">
                <span class="entry-title">{t.title}</span>
                <span class="entry-side">{t.venue} · {t.date}</span>
              </div>
              {t.detail && <div class="entry-body">{t.detail}</div>}
              {t.url && <div class="entry-url">{t.url}</div>}
            </div>
          ))}
        </section>
      )}

      <!-- Page footer line — subtle, professional touch -->
      <footer class="pgfoot">
        <span>{profile.name}</span>
        <span class="dot">·</span>
        <span>{profile.headline}</span>
        <span class="dot">·</span>
        <span>{profile.email}</span>
      </footer>
    </main>

    <!-- ═════════════ Minimal floating bar (screen only) ═════════════
         Sits at the bottom-right. Mode-aware via tokens:
           LIGHT — dark-blue pill, white CTA
           DARK  — light pill, dark-blue CTA
         Stripped from PDF via .no-print. -->
    <div class="dock no-print">
      <a class="dock-link" href="/resume">
        <span aria-hidden="true">←</span>
        <span class="encrypt-tap" data-text="Web view">Web view</span>
      </a>
      <a
        class="dock-cta"
        href={profile.resumeFile}
        download="Mitul-Vaghasiya-Resume.pdf"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="dock-cta-icon">
          <path d="M10 3v9m0 0l-4-4m4 4l4-4M4 16h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="encrypt-tap" data-text="Save as PDF">Save as PDF</span>
      </a>
    </div>

    <style>
      :root {
        /* MONO palette — applies to the resume content (.page) on both
           screen and print. Hierarchy comes from value, weight, and size. */
        --ink:     #111;              /* body text */
        --strong:  #000;              /* name, h2, company, accent bars */
        --mid:     #4b4f55;           /* secondary text (period, location) */
        --soft:    #6c7077;           /* tertiary text */
        --softer:  #8a8e94;           /* labels, footer */
        --rule:    #c8c8c8;           /* light dividers */
        --rule-2:  #e2e2e2;           /* lighter row dividers */

        /* ═════════════ THEME palette — Onyx, mode-aware ═════════════
           Screen-only preview shell. Print stylesheet hides all chrome.
           Variant 13 — "Gradient Hover Stop": dock uses an accent →
           accent-hover diagonal gradient with a glow, white pill CTA
           inside. All values come from globals.css Onyx tokens.
        */

        /* Onyx palette (space-separated so they compose with alpha) */
        --v-bg:             238 242 248;
        --v-paper:          222 230 240;
        --v-accent:          24  96 160;
        --v-accent-hover:   16  76 134;
        --v-accent-soft:   156 192 226;

        /* Derived chrome tokens */
        --t-bg:             rgb(var(--v-bg));
        --t-card-shadow:    0 1px 2px rgb(8 16 32 / 0.04),
                            0 6px 18px -4px rgb(8 16 32 / 0.06),
                            0 24px 60px -16px rgb(8 16 32 / 0.10);
        --t-card-border:    rgb(214, 224, 238);

        --t-cta-bg:         #ffffff;
      }
      /* Dark mode tokens — driven by html.dark, which the website's theme
         toggle adds/removes via localStorage("theme"). Class-based (NOT
         prefers-color-scheme) so the preview follows the toggle, not the OS. */
      html.dark {
        --v-bg:               6  12  22;
        --v-paper:           14  22  36;
        --v-accent:         140 198 250;
        --v-accent-hover:   180 224 254;
        --v-accent-soft:     22  50  86;

        --t-bg:             rgb(var(--v-bg));
        --t-card-shadow:    0 1px 2px rgb(0 0 0 / 0.40),
                            0 8px 24px -6px rgb(0 0 0 / 0.45),
                            0 32px 80px -20px rgb(0 0 0 / 0.55);
        --t-card-border:    rgb(48, 64, 92);

        --t-cta-bg:         rgb(var(--v-bg));
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        /* Solid backdrop — matches the Onyx theme bg in each mode. No
           gradient, no lift; reads cleanly and matches the website. */
        background: var(--t-bg);
        min-height: 100vh;
        color: var(--ink);
      }
      body {
        /* ATS-safe font chain — system fonts, no web font load */
        font-family: "Calibri", "Segoe UI", "Arial", "Helvetica Neue", Helvetica, sans-serif;
        font-size: 10.5pt;
        line-height: 1.45;
        font-feature-settings: "kern" 1, "liga" 1;
      }

      /* On-screen: simulate an A4 page floating on a soft grey backdrop.
         In print: page extends edge-to-edge of A4 with its own margins. */
      .page {
        max-width: 210mm;
        margin: 40px auto 100px;
        background: #fff;
        /* Tighter horizontal + vertical padding gives more usable area and
           lets the doc breathe inside 2 pages instead of bleeding to 3. */
        padding: 12mm 14mm 11mm;
        /* Layered card shadow — driven by tokens so it adapts per mode. */
        box-shadow: var(--t-card-shadow);
        border: 1px solid var(--t-card-border);
        border-radius: 4px;
      }

      /* ═════════════ Header ═════════════ */
      .hdr-name {
        margin: 0;
        font-size: 28pt;
        font-weight: 700;
        letter-spacing: -0.6pt;
        color: var(--strong);
        line-height: 1.0;
      }
      .hdr-role {
        margin: 5pt 0 0;
        font-size: 13pt;
        font-weight: 500;
        color: var(--ink);
        letter-spacing: 0.1pt;
      }
      /* Header rule — single elegant 0.6pt hairline spanning the full
         content width. Replaces the prior heavy double-bar treatment for
         a more refined editorial feel. */
      .hdr-rule {
        display: block;
        height: 0.6pt;
        background: var(--strong);
        width: 100%;
        margin: 8pt 0 11pt;
      }
      .hdr-rule-thick,
      .hdr-rule-thin { display: none; }

      .hdr-rows {
        display: flex;
        flex-direction: column;
        gap: 4pt;
      }
      .hdr-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18pt;
      }
      .hdr-row--meta {
        grid-template-columns: 2fr 1fr 1.4fr;
        margin-top: 4pt;
      }
      .hdr-cell, .hdr-meta-cell {
        display: flex;
        flex-direction: column;
        gap: 1.5pt;
        line-height: 1.25;
      }
      .hdr-cell--right { text-align: right; align-items: flex-end; }
      .hdr-label {
        font-size: 7.5pt;
        font-weight: 700;
        /* See h2 note — letter-spacing breaks ATS keyword extraction. */
        letter-spacing: 0;
        text-transform: uppercase;
        color: var(--softer);
      }
      .hdr-value {
        font-size: 10.25pt;
        color: var(--ink);
        text-decoration: none;
        font-weight: 500;
      }
      a.hdr-value { color: var(--ink); }

      /* ═════════════ Section spacing — single, even rhythm ═════════════
         Every section sits 12pt below the previous. H2 → first content
         is always 6pt. Tuned so the full doc lands cleanly inside 2 A4
         pages for a 6+ YOE candidate.  */
      section { margin-top: 12pt; }
      /* Section heading — read as a proper TITLE, distinct from body type.
         13.5pt uppercase (vs 10pt body) sets clear hierarchy. Small vertical
         accent bar to the left frames it as a chapter mark. Single 0.4pt
         hairline beneath closes the title block. No letter-spacing — Chrome
         PDF emits CSS tracking as literal space chars and breaks ATS. */
      h2 {
        display: flex;
        align-items: center;
        gap: 9pt;
        margin: 0 0 9pt;
        padding-bottom: 5pt;
        border-bottom: 0.4pt solid var(--strong);
        font-size: 13.5pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0;
        color: var(--strong);
        line-height: 1.15;
      }
      /* Vertical accent — small chapter mark to the left of the title.
         2pt wide, 13pt tall — proportional to the title height, reads as
         an editorial flourish without the heaviness of a 3pt block bar. */
      .h2-bar {
        display: inline-block;
        width: 2pt;
        height: 13pt;
        background: var(--strong);
        flex-shrink: 0;
      }
      .h2-text { display: inline; white-space: nowrap; }
      .h2-rule { display: none; }

      p { margin: 0; }
      .summary {
        font-size: 10pt;
        line-height: 1.42;
        text-align: left;
        color: var(--ink);
      }

      /* ═════════════ Roles / Education ═════════════ */
      .role { margin-top: 8pt; page-break-inside: avoid; }
      .role.role--first { margin-top: 0; }

      .role-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 14pt;
      }
      .role-row--sub { margin-top: 1pt; }

      .role-company {
        font-size: 11.5pt;
        font-weight: 700;
        color: var(--strong);
        letter-spacing: 0.1pt;
      }
      .role-period {
        font-size: 9.75pt;
        font-weight: 600;
        color: var(--mid);
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.2pt;
      }
      .role-title {
        font-size: 10.25pt;
        font-style: italic;
        font-weight: 500;
        color: var(--ink);
      }
      .role-loc {
        font-size: 9.75pt;
        color: var(--mid);
        text-align: right;
        white-space: nowrap;
      }

      /* Em-dash bullets with hanging indent */
      .bullets {
        margin: 4pt 0 0;
        padding: 0;
        list-style: none;
        orphans: 2;
        widows: 2;
      }
      .bullets li {
        position: relative;
        padding-left: 13pt;
        margin-bottom: 1.5pt;
        font-size: 9.5pt;
        line-height: 1.35;
        text-align: left;
      }
      .bullets li::before {
        content: "—";
        position: absolute;
        left: 0;
        top: 0;
        color: var(--strong);
        font-weight: 700;
      }

      /* ═════════════ Projects ═════════════ */
      /* Same flush-row alignment as roles, slightly tighter rhythm.
         Project name in black bold; period right-aligned tabular-nums.
         Role + stack on row 2 (left), employer on row 2 (right).
         One-line description below. Mono only. */
      .project { margin-top: 5pt; page-break-inside: avoid; }
      .project:first-of-type { margin-top: 0; }
      .project-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 14pt;
      }
      .project-row--sub { margin-top: 1pt; }
      .project-name {
        font-size: 11pt;
        font-weight: 700;
        color: var(--strong);
        letter-spacing: 0.1pt;
      }
      .project-period {
        font-size: 9.75pt;
        font-weight: 600;
        color: var(--mid);
        text-align: right;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.2pt;
      }
      .project-meta {
        font-size: 9.75pt;
        color: var(--ink);
      }
      .project-role {
        font-style: italic;
        font-weight: 500;
      }
      .project-sep { color: var(--softer); }
      .project-stack { color: var(--mid); }
      .project-employer {
        font-size: 9.75pt;
        color: var(--mid);
        text-align: right;
        white-space: nowrap;
      }
      .project-line {
        margin: 1.5pt 0 0;
        font-size: 9.5pt;
        line-height: 1.3;
        color: var(--ink);
      }

      /* ═════════════ Skills ═════════════ */
      /* Two-column grid of category cards. Each cell stacks label (top) over
         comma-separated skills (below). Halves the vertical space vs a flat
         label/value list, lets the section land cleanly on page 2 alongside
         Education + Certs, and stays ATS-parseable (source order is row-major:
         cat1 / list1 / cat2 / list2 / cat3 / …). */
      .skills {
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 22pt;
        row-gap: 6pt;
      }
      .skill-row {
        display: block;
        page-break-inside: avoid;
      }
      .skill-row dt {
        font-size: 8.5pt;
        font-weight: 700;
        text-transform: uppercase;
        /* See h2 note — letter-spacing breaks ATS keyword extraction. */
        letter-spacing: 0;
        color: var(--strong);
        line-height: 1.3;
        margin-bottom: 1pt;
      }
      .skill-row dd {
        margin: 0;
        font-size: 9.75pt;
        color: var(--ink);
        line-height: 1.4;
        word-spacing: 0.3pt;
      }

      /* ═════════════ Certs / OSS / Talks ═════════════ */
      .entry { margin-top: 6pt; page-break-inside: avoid; }
      .entry:first-of-type { margin-top: 0; }
      .entry-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12pt;
      }
      .entry-title {
        font-size: 10.5pt;
        font-weight: 700;
        color: var(--strong);
      }
      .entry-side {
        font-size: 9.75pt;
        color: var(--mid);
        text-align: right;
        white-space: nowrap;
      }
      .entry-body {
        font-size: 10pt;
        margin-top: 2pt;
        color: var(--ink);
      }
      .entry-url {
        font-size: 9pt;
        color: var(--soft);
        margin-top: 1pt;
        word-break: break-all;
      }
      /* In the printed/PDF version, suppress long verification URLs — they
         add no scannable value for a recruiter or ATS (the issuer name is
         what counts), and they cost a full line that costs us page-2 fit. */
      @media print { .entry-url { display: none; } }

      /* ═════════════ Page footer ═════════════ */
      /* Single thin black rule above the footer line — matches the editorial
         calm of the rest of the document. No double-rule clutter. */
      .pgfoot {
        margin-top: 12pt;
        padding-top: 6pt;
        font-size: 8.25pt;
        color: var(--softer);
        text-align: center;
        letter-spacing: 0;
        /* Subtle hairline — sits behind the editorial focus, doesn't
           compete with the section rules. */
        border-top: 0.3pt solid var(--rule-2);
      }
      .pgfoot .dot { color: var(--rule); margin: 0 5pt; }

      /* ═════════════ Floating dock — Variant 13 (Gradient Hover Stop)
         Pill at bottom-right. Gradient bar from --accent to --accent-hover
         (deeper, bolder feel). White pill CTA inside (bg-colored in dark).
         Glow shadow tinted with --accent-hover at 50%.
         Hidden from print via .no-print. */
      .dock {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 50;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 6px 5px 8px;
        background: linear-gradient(135deg,
          rgb(var(--v-accent)),
          rgb(var(--v-accent-hover)));
        color: #ffffff;
        border-radius: 999px;
        font-family: "Inter", "Segoe UI", "Calibri", "Arial", sans-serif;
        box-shadow:
          0 10px 28px -6px rgb(var(--v-accent-hover) / 0.55),
          0 2px 8px -2px rgb(8 16 32 / 0.18);
      }
      html.dark .dock { color: rgb(var(--v-bg)); }

      .dock-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        color: inherit;
        text-decoration: none;
        font-size: 9.5pt;
        font-weight: 500;
        opacity: 0.85;
        border-radius: 999px;
        transition: opacity 0.15s ease, background 0.15s ease;
      }
      .dock-link:hover {
        opacity: 1;
        background: rgb(255 255 255 / 0.12);
      }
      html.dark .dock-link:hover { background: rgb(var(--v-bg) / 0.10); }

      .dock-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        background: var(--t-cta-bg);
        color: rgb(var(--v-accent));
        text-decoration: none;
        font-size: 10pt;
        font-weight: 700;
        border-radius: 999px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        box-shadow: 0 1px 0 rgb(8 16 32 / 0.05);
      }
      .dock-cta:hover {
        transform: translateY(-0.5px);
        box-shadow: 0 6px 14px -4px rgb(8 16 32 / 0.25);
      }
      .dock-cta-icon {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
      }

      @media (max-width: 480px) {
        .dock { right: 12px; bottom: 12px; }
        .dock-link span:last-child { display: none; }
      }

      /* ═════════════ Encryption hover (screen only) ═════════════
         Same effect as the rest of the website's buttons — text scrambles
         through cipher chars with a chromatic teal/red/white split, then
         resolves left-to-right. Only the label text gets .encrypt-tap so
         the SVG icon stays static. Engine lives in the <script> below.
         Hidden from print via the .no-print parent dock. */
      .encrypt-tap { position: relative; display: inline-block; }
      .encrypt-tap.is-encrypting {
        font-variant-numeric: tabular-nums;
        text-shadow:
          -1px 0 0 rgb(244 63 94 / 0.85),
           1px 0 0 rgb(var(--enc-accent, 24 96 160) / 0.85);
      }
      .encrypt-tap .enc-wrap,
      .encrypt-tap .enc-wrap *,
      .encrypt-tap .enc-c1,
      .encrypt-tap .enc-c2,
      .encrypt-tap .enc-c3 {
        pointer-events: none;
        -webkit-user-select: none;
        user-select: none;
      }
      .encrypt-tap .enc-c1 { color: rgb(var(--enc-accent, 24 96 160)); }
      .encrypt-tap .enc-c2 { color: rgb(244 63 94); }
      .encrypt-tap .enc-c3 { color: #ffffff; }
      /* Pick up the actual Onyx accent in each mode so the chromatic shadow
         matches the rest of the site (light = deep blue, dark = light cyan). */
      :root      { --enc-accent: 24 96 160; }
      html.dark  { --enc-accent: 140 198 250; }

      /* ═════════════ Print stylesheet ═════════════ */
      @media print {
        @page {
          size: A4;
          /* Margins on @page (not .page) so EVERY printed page has the
             same inset — otherwise pages 2+ would have content bleed right
             to the paper edge while only page 1 had a margin. */
          margin: 11mm 13mm 10mm;
        }
        /* Reset the themed backdrop — PDF output is fully mono. */
        html, body {
          background: #fff !important;
          background-image: none !important;
        }
        .no-print { display: none !important; }
        .page {
          margin: 0;
          padding: 0;
          max-width: none;
          width: auto;
          min-height: auto;
          box-shadow: none;
          background: #fff;
          /* Strip the on-screen "floating card" frame — an ATS résumé must be
             borderless (boxes/frames confuse parsers and look non-standard in
             the PDF). The screen .page sets border + radius; reset BOTH here. */
          border: 0;
          border-radius: 0;
        }
        /* ── Page-break discipline ──
           1. Header is one unit — never split company name across pages.
           2. Section h2 stays with first content.
           3. Roles, projects, entries, skill rows are each atomic units.
           4. The Summary paragraph stays whole.
           5. Skills / Education / Certifications are short enough to never split.
           Experience can break BETWEEN roles, Projects can break BETWEEN
           projects — never inside one. */
        .hdr { page-break-inside: avoid; }
        h2 { page-break-after: avoid; break-after: avoid; }
        .summary, .role, .project, .entry, .skill-row {
          page-break-inside: avoid;
          break-inside: avoid;
        }
        /* Small sections that should stay whole regardless of position */
        section.tight { page-break-inside: avoid; break-inside: avoid; }
      }
    </style>

    <!-- ─── Encryption scramble engine — same as src/layouts/Base.astro ───
         Scrambles any element with .encrypt-tap on hover/focus. Skipped
         when prefers-reduced-motion is set. Width + height locked via an
         inner wrapper span so the dock buttons never jitter. All scramble
         spans are pointer-events:none so taps reliably reach the anchor. -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const CIPHER = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789!@#$%&*<>{}[]_/\\";
        const FRAMES = 22;
        const FRAME_MS = 28;
        const REVEAL_START = 6;
        const CHANNELS = ["enc-c1", "enc-c1", "enc-c1", "enc-c2", "enc-c3"];

        const randChar = () => CIPHER[Math.floor(Math.random() * CIPHER.length)];
        const randChannel = () => CHANNELS[Math.floor(Math.random() * CHANNELS.length)];
        const escapeHTML = (s) => s.replace(/[&<>"']/g, (c) => (
          { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c]
        ));

        function measureInner(el, text) {
          const probe = document.createElement("span");
          const cs = getComputedStyle(el);
          probe.style.cssText =
            "visibility:hidden;position:absolute;left:-9999px;top:0;" +
            "white-space:pre;pointer-events:none;display:inline-block;";
          probe.style.fontFamily = cs.fontFamily;
          probe.style.fontSize = cs.fontSize;
          probe.style.fontWeight = cs.fontWeight;
          probe.style.fontStyle = cs.fontStyle;
          probe.style.letterSpacing = cs.letterSpacing;
          probe.style.textTransform = cs.textTransform;
          probe.style.fontVariantCaps = cs.fontVariantCaps;
          probe.style.lineHeight = cs.lineHeight;
          probe.textContent = text;
          document.body.appendChild(probe);
          const r = probe.getBoundingClientRect();
          document.body.removeChild(probe);
          return { width: r.width, height: r.height };
        }

        function scramble(el) {
          if (el.__encryptId) return;
          const real = el.getAttribute("data-text") || el.textContent.trim();
          if (!real) return;
          const dims = measureInner(el, real);
          const cs = getComputedStyle(el);
          const lineHeight = cs.lineHeight === "normal"
            ? (parseFloat(cs.fontSize) * 1.2).toFixed(2) + "px"
            : cs.lineHeight;
          el.classList.add("is-encrypting");
          let frame = 0;
          el.__encryptId = setInterval(() => {
            frame++;
            const t = Math.max(0, frame - REVEAL_START) / (FRAMES - REVEAL_START);
            const revealed = Math.floor(real.length * Math.min(1, t));
            let inner = "";
            for (let i = 0; i < real.length; i++) {
              const c = real[i];
              if (i < revealed || c === " " || /[^A-Za-z0-9]/.test(c)) {
                inner += escapeHTML(c);
              } else {
                inner += '<span class="' + randChannel() + '">' + escapeHTML(randChar()) + "</span>";
              }
            }
            el.innerHTML =
              '<span class="enc-wrap" style="display:inline-block;' +
              'width:' + dims.width.toFixed(2) + 'px;' +
              'height:' + dims.height.toFixed(2) + 'px;' +
              'line-height:' + lineHeight + ';' +
              'overflow:hidden;white-space:nowrap;text-align:left;' +
              'vertical-align:middle">' + inner + "</span>";
            if (frame >= FRAMES) finish(el);
          }, FRAME_MS);
        }

        function finish(el) {
          if (!el.__encryptId) return;
          clearInterval(el.__encryptId);
          el.__encryptId = null;
          el.textContent = el.getAttribute("data-text") || el.textContent;
          el.classList.remove("is-encrypting");
        }

        // Don't scramble during a tap — resolves the click target stably.
        let interactingEl = null;
        document.addEventListener("pointerdown", (e) => {
          const el = e.target.closest && e.target.closest(".encrypt-tap");
          if (!el) return;
          interactingEl = el;
          if (el.__encryptId) finish(el);
        }, true);
        document.addEventListener("pointerup",    () => { interactingEl = null; }, true);
        document.addEventListener("pointercancel",() => { interactingEl = null; }, true);

        document.addEventListener("mouseenter", (e) => {
          const el = e.target.closest && e.target.closest(".encrypt-tap");
          if (!el || el === interactingEl) return;
          scramble(el);
        }, true);
        document.addEventListener("focusin", (e) => {
          const el = e.target.closest && e.target.closest(".encrypt-tap");
          if (!el || el === interactingEl) return;
          scramble(el);
        });
      })();
    </script>
  </body>
</html>
