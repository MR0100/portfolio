---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import SkillsSection from "~/components/SkillsSection.astro";
import SpecBlock from "~/components/SpecBlock.astro";
import SpecRow from "~/components/SpecRow.astro";
import SpecimenHeading from "~/components/SpecimenHeading.astro";
import { profile, experience, education, certifications } from "~/data/profile";

const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);

const byEmployer = new Map<string, typeof all>();
for (const e of all) {
  const key = e.data.employer;
  if (!byEmployer.has(key)) byEmployer.set(key, []);
  byEmployer.get(key)!.push(e);
}

const verified = all.filter((e) => e.data.status === "verified").length;
const regions = new Set(all.map((e) => e.data.region));
const cities = new Set(
  all.filter((e) => e.data.city).map((e) => `${e.data.city},${e.data.country}`),
);
const industries = new Set(all.map((e) => e.data.category));
---

<Base title="Resume" description={`Resume for ${profile.name} — senior mobile engineer & development lead, ${profile.yearsExperience} years shipping Flutter apps across diamond trading, agritech, health, and consumer. Experience, skills, education, contact.`}>
  <section class="container-page pt-10 md:pt-14">
    <!-- Ribbon -->
    <div class="flex flex-wrap items-baseline justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.24em] text-muted">
      <div>Resume · 2026.06</div>
      <div>Generated from {all.length} projects</div>
    </div>
    <div class="mt-4 rule-thin"></div>

    <!-- Title -->
    <header class="mt-10 md:mt-14 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-12 lg:items-end">
      <div class="space-y-6">
        <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-sepia">Resume</div>
        <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] font-semibold tracking-tight leading-[0.92]">
          {profile.name}<span class="text-accent">.</span>
        </h1>
        <p class="font-serif text-xl md:text-2xl text-text/85 leading-snug max-w-3xl">
          {profile.bioShort}
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={profile.resumeFile}
            download
            class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover"
          >
            Download PDF →
          </a>
          <a
            href="javascript:window.print()"
            class="inline-flex items-center gap-2 rounded-md border border-border bg-paper/60 px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-text hover:border-accent/40 hover:text-accent transition-colors"
          >
            Print this page
          </a>
        </div>
      </div>

      <SpecBlock label="Subject metadata" trailing="00.A">
        <SpecRow label="Doc rev.">2026.06</SpecRow>
        <SpecRow label="Based">{profile.location}</SpecRow>
        <SpecRow label="Languages">{profile.languagesSpoken.join(" / ")}</SpecRow>
        <SpecRow label="Yrs">{profile.yearsExperience}</SpecRow>
        <SpecRow label="Email">{profile.email}</SpecRow>
        <SpecRow label="Github">@MR0100</SpecRow>
        <SpecRow label="LinkedIn">/mitul-vaghasiya-075a53166</SpecRow>
      </SpecBlock>
    </header>
  </section>

  <!-- Stat grid -->
  <section class="container-page mt-16 md:mt-20">
    <div class="rule-thin mb-8"></div>
    <dl class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-10">
      <div class="space-y-1.5">
        <dt class="stat-label text-sepia">Experience</dt>
        <dd class="stat-num">{profile.yearsExperience}</dd>
        <dd class="stat-label">years in field</dd>
      </div>
      <div class="space-y-1.5">
        <dt class="stat-label text-sepia">Apps shipped</dt>
        <dd class="stat-num">{all.length}</dd>
        <dd class="stat-label">projects</dd>
      </div>
      <div class="space-y-1.5">
        <dt class="stat-label text-sepia">Verified</dt>
        <dd class="stat-num">{verified}</dd>
        <dd class="stat-label">in public stores</dd>
      </div>
      <div class="space-y-1.5">
        <dt class="stat-label text-sepia">Industries</dt>
        <dd class="stat-num">{industries.size}</dd>
        <dd class="stat-label">categories</dd>
      </div>
      <div class="space-y-1.5">
        <dt class="stat-label text-sepia">Cities</dt>
        <dd class="stat-num">{cities.size}</dd>
        <dd class="stat-label">on the map</dd>
      </div>
    </dl>
    <div class="rule-thin mt-8"></div>
  </section>

  <!-- § I — Experience as a datasheet -->
  <section class="container-page mt-20 md:mt-24">
    <SpecimenHeading num="01" title="Experience" trailing={`${experience.length} roles`} />

    <ol class="mt-12 space-y-16 relative md:pl-10">
      {experience.map((role) => {
        const projectsAtThisEmployer = byEmployer.get(role.company) ?? [];
        return (
          <li class="relative md:grid md:grid-cols-[180px_1fr] md:gap-10">
            <aside class="md:sticky md:top-24 md:self-start space-y-2 mb-4 md:mb-0">
              <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-accent">{role.period}</div>
              <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">{role.location}</div>
            </aside>

            <div class="space-y-6 relative">
              <div class="absolute -left-[26px] top-2 hidden md:block">
                <span class="block h-2 w-2 rounded-full bg-accent" />
              </div>
              <div>
                <h3 class="font-display text-2xl md:text-3xl font-semibold tracking-tight leading-tight">
                  {role.title}
                </h3>
                <div class="mt-1 font-mono text-xs uppercase tracking-[0.24em] text-muted">{role.company}</div>
              </div>
              <ul class="space-y-3 text-base md:text-lg text-text leading-relaxed font-serif max-w-prose">
                {role.highlights.map((h) => (
                  <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-px before:w-3 before:bg-accent/60">
                    {h}
                  </li>
                ))}
              </ul>

              {projectsAtThisEmployer.length > 0 && (
                <div class="mt-6 pt-6 border-t border-border/60">
                  <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-sepia mb-3">
                    Projects shipped here · {projectsAtThisEmployer.length}
                  </div>
                  <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 font-serif text-base">
                    {projectsAtThisEmployer.map((e) => (
                      <li class="flex items-baseline gap-2">
                        <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted tabular-nums">
                          {String(e.data.order).padStart(2, "0")}
                        </span>
                        <a href={`/work/${e.slug}`} class="link-underline">
                          {e.data.title}
                        </a>
                        {e.data.city && (
                          <span class="text-muted text-sm"> — {e.data.city}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- § II — Skills (searchable) -->
  <section class="container-page mt-20 md:mt-24">
    <SpecimenHeading num="02" title="Skills" trailing="searchable" />
    <p class="mt-4 max-w-2xl font-serif text-base md:text-lg text-muted">
      Search or filter by category. Hit <kbd class="rounded border border-border px-1.5 py-0.5 font-mono text-xs">/</kbd> anywhere to jump to the search box.
    </p>
    <div class="mt-6 rule-thin mb-10"></div>

    <SkillsSection />
  </section>

  <!-- § III — Schooling -->
  <section class="container-page mt-20 md:mt-24">
    <SpecimenHeading num="03" title="Education" />
    <div class="mt-8 rule-thin mb-12"></div>

    <div class="grid gap-12 md:grid-cols-2">
      <div class="space-y-5">
        <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-sepia">Education</div>
        {education.map((edu) => (
          <div class="space-y-1">
            <div class="font-display text-lg font-semibold tracking-tight">{edu.degree}</div>
            <div class="font-serif text-base text-muted">{edu.institution}</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">{edu.period} · {edu.location}</div>
          </div>
        ))}
      </div>

      <div class="space-y-5">
        <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-sepia">Certifications</div>
        {certifications.map((cert) => (
          <div class="space-y-1">
            <div class="font-display text-lg font-semibold tracking-tight">
              {cert.url ? (
                <a href={cert.url} target="_blank" rel="noreferrer noopener" class="link-underline">{cert.title}</a>
              ) : (
                cert.title
              )}
            </div>
            <div class="font-serif text-base text-muted">{cert.issuer}{cert.note ? ` · ${cert.note}` : ""}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- § IV — Contact -->
  <section class="container-page mt-20 md:mt-24">
    <SpecimenHeading num="04" title="Contact" />
    <div class="mt-8 rule-thin mb-10"></div>

    <SpecBlock label="Channels" trailing="04.A">
      <SpecRow label="Email"><a href={profile.socials.email} class="link-underline">{profile.email}</a></SpecRow>
      <SpecRow label="GitHub"><a href={profile.socials.github} target="_blank" rel="noreferrer noopener" class="link-underline">github.com/MR0100</a></SpecRow>
      <SpecRow label="LinkedIn"><a href={profile.socials.linkedin} target="_blank" rel="noreferrer noopener" class="link-underline">/in/mitul-vaghasiya-075a53166</a></SpecRow>
      <SpecRow label="Twitter / X"><a href={profile.socials.twitter} target="_blank" rel="noreferrer noopener" class="link-underline">@_MR_0100</a></SpecRow>
      <SpecRow label="Based">{profile.location}</SpecRow>
      <SpecRow label="Languages">{profile.languagesSpoken.join(" / ")}</SpecRow>
    </SpecBlock>
  </section>
</Base>

<style>
  @media print {
    nav, footer, .reveal { display: revert; }
    body { background: white; }
    .atmosphere { display: none !important; }
  }
</style>
