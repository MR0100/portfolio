---
import Base from "~/layouts/Base.astro";
import { profile, experience, education, certifications, openSource, talks, skillGroups } from "~/data/profile";

// Build-time stamp (YYYY.MM) so the ribbon date never goes stale.
const asOf = new Date().toISOString().slice(0, 7).replace("-", ".");

// ──────────────────────────────────────────────────────────────────────────
// Resume — redesigned per T01 Resume Fundamentals.
// Strict editorial order: Header → Summary → Meta strip → Experience → Skills
// → Education → (Optional: External signal) → Contact.
// Strip mode: every component earns its place; no decorative SpecBlocks, no
// redundant stats grid, no in-page skill search — those belong in tools, not
// on a resume. The visual hierarchy mirrors the print view so the two stay
// in sync as you tune copy.
// ──────────────────────────────────────────────────────────────────────────

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

// Per the T01 guide: one-line top-of-page meta strip. Short, scannable.
const metaCells = [
  { label: "YOE",        value: profile.yearsExperience + " yrs" },
  { label: "Now",        value: "KGK Buy Diamonds + HRMS" },
  { label: "Notice",     value: profile.noticePeriod },
  { label: "Open to",    value: "Senior IC · Lead · Architecture" },
  { label: "Languages",  value: profile.languagesSpoken.join(" / ") },
];

const linkedinDisplay = "linkedin.com/in/mitul-vaghasiya";
const githubDisplay = "github.com/MR0100";
---

<Base
  title="Resume"
  description={`Resume for ${profile.name} — ${profile.headline}. ${profile.yearsExperience} years shipping Flutter + native mobile apps, 19 production builds across iOS + Android.`}
>
  <article class="container-page py-12 md:py-16">
    <!-- ── Top ribbon ── -->
    <div class="flex flex-wrap items-baseline justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.24em] text-muted">
      <div><span class="text-accent">§</span>&nbsp;Resume · {asOf}</div>
      <a href="/resume/print" class="hover:text-accent transition-colors">ATS-safe print view →</a>
    </div>
    <div class="mt-4 rule-thin"></div>

    <!-- ── Header — name + role + summary + actions ── -->
    <header class="mt-10 md:mt-14 max-w-4xl">
      <div class="font-mono text-[10px] uppercase tracking-[0.42em] text-sepia mb-5">
        <span class="text-accent">—</span>&nbsp;Resume
      </div>

      <h1 class="font-display text-5xl md:text-7xl lg:text-[5.5rem] font-semibold tracking-tight leading-[0.92]">
        {profile.name}<span class="text-accent">.</span>
      </h1>
      <div class="mt-4 font-display text-xl md:text-2xl tracking-tight text-muted">
        {profile.headline}
      </div>

      <p class="mt-7 max-w-prose font-serif text-lg md:text-xl text-text leading-relaxed">
        {profile.bioShort}
      </p>

      <!-- Inline contact line — keeps everything findable without a boxed card -->
      <div class="mt-7 font-mono text-[11px] uppercase tracking-[0.22em] text-muted flex flex-wrap items-center gap-x-3 gap-y-2">
        <span>{profile.location}</span>
        <span class="opacity-40">·</span>
        <a href={profile.socials.email} class="hover:text-accent transition-colors">{profile.email}</a>
        <span class="opacity-40">·</span>
        <a href={profile.socials.linkedin} target="_blank" rel="noreferrer noopener" class="hover:text-accent transition-colors">{linkedinDisplay}</a>
        <span class="opacity-40">·</span>
        <a href={profile.socials.github} target="_blank" rel="noreferrer noopener" class="hover:text-accent transition-colors">{githubDisplay}</a>
      </div>

      <!-- Actions — single tier of CTAs -->
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/resume/print"
          class="btn-primary"
        >
          ATS-safe print view →
        </a>
        <a
          href={profile.resumeFile}
          download
          class="btn-outline"
        >
          Download PDF
        </a>
        <a
          href="/work"
          class="btn-ghost"
        >
          Selected work →
        </a>
      </div>
    </header>

    <!-- ── Meta strip — horizontal facts band, replaces the old subject-metadata SpecBlock ── -->
    <dl class="mt-14 md:mt-16 grid grid-cols-2 md:grid-cols-5 border-t border-b border-border">
      {metaCells.map((c) => (
        <div class="border-r border-border last:border-r-0 px-4 py-4 odd:border-r md:border-b-0 border-b">
          <dt class="eyebrow">{c.label}</dt>
          <dd class="mt-1.5 font-serif text-base text-text leading-snug">{c.value}</dd>
        </div>
      ))}
    </dl>

    <!-- ── § 01 · Experience ── -->
    <section class="mt-20 md:mt-28">
      <div class="specimen-heading">
        <span class="num">§ 01</span>
        <span>—</span>
        <span class="text-text">Experience</span>
        <span class="sep" aria-hidden="true"></span>
        <span>{experience.length} roles</span>
      </div>

      <ol class="mt-10 space-y-14 md:pl-10 relative">
        {experience.map((role, i) => (
          <li class="relative md:grid md:grid-cols-[200px_1fr] md:gap-10">
            <!-- Sticky date column on desktop, inline label on mobile -->
            <aside class="md:sticky md:top-24 md:self-start space-y-2 mb-4 md:mb-0">
              <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-accent">{role.period}</div>
              <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">{role.location}</div>
              <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">§ {String(i + 1).padStart(2, "0")} of {String(experience.length).padStart(2, "0")}</div>
            </aside>

            <div class="space-y-5 relative">
              <!-- Timeline node — visible on desktop only -->
              <span class="hidden md:block absolute -left-[26px] top-3 h-2 w-2 rounded-full bg-accent" aria-hidden="true" />

              <header>
                <h3 class="font-display text-2xl md:text-3xl font-semibold tracking-tight leading-tight">
                  {role.title}
                </h3>
                <div class="mt-1 font-mono text-xs uppercase tracking-[0.24em] text-muted">{role.company}</div>
              </header>

              <ul class="space-y-3 text-base md:text-[1.0625rem] text-text/90 leading-relaxed font-serif">
                {role.highlights.map((h) => (
                  <li class="relative pl-6 before:absolute before:left-0 before:top-[0.85em] before:h-px before:w-3.5 before:bg-accent/60">
                    {h}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── § 02 · Skills ── -->
    <section class="mt-24 md:mt-32">
      <div class="specimen-heading">
        <span class="num">§ 02</span>
        <span>—</span>
        <span class="text-text">Skills</span>
        <span class="sep" aria-hidden="true"></span>
        <span>{skillGroups.length} categories</span>
      </div>

      <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {skillGroups.map((group, i) => (
          <div class="space-y-4" id={`skills-${slug(group.title)}`}>
            <div class="flex items-baseline justify-between gap-4 pb-2 border-b border-border/60">
              <h3 class="font-mono text-[11px] uppercase tracking-[0.22em] text-text">{group.title}</h3>
              <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">§ {String(i + 1).padStart(2, "0")}</span>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {group.skills.map((s) => (
                <li class:list={["chip", s.level === "expert" && "chip-accent"]}>
                  {s.level === "expert" && <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />}
                  {s.level === "strong" && <span class="h-1.5 w-1.5 rounded-full bg-accent/55" aria-hidden="true" />}
                  {s.level === "learning" && <span class="h-1.5 w-1.5 rounded-full bg-sepia" aria-hidden="true" />}
                  {s.name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Tiny legend — explains the dots without crowding the section -->
      <div class="mt-8 flex flex-wrap items-center gap-5 font-mono text-[10px] uppercase tracking-[0.22em] text-muted">
        <span class="inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span> Expert
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent/55" aria-hidden="true"></span> Strong
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-muted/40" aria-hidden="true"></span> Familiar
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-sepia" aria-hidden="true"></span> Learning
        </span>
      </div>
    </section>

    <!-- ── § 03 · Education + Certifications ── -->
    <section class="mt-24 md:mt-32">
      <div class="specimen-heading">
        <span class="num">§ 03</span>
        <span>—</span>
        <span class="text-text">Education</span>
        <span class="sep" aria-hidden="true"></span>
        <span>{education.length} degree{education.length !== 1 ? "s" : ""}{certifications.length > 0 ? ` · ${certifications.length} cert` : ""}</span>
      </div>

      <div class="mt-10 grid gap-12 md:grid-cols-2">
        <!-- Education -->
        <div class="space-y-6">
          <div class="eyebrow">Education</div>
          {education.map((edu) => (
            <div class="space-y-1.5">
              <div class="font-display text-lg font-semibold tracking-tight">{edu.degree}</div>
              <div class="font-serif text-base text-muted">{edu.institution}</div>
              <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">{edu.period} · {edu.location}</div>
            </div>
          ))}
        </div>

        <!-- Certifications -->
        {certifications.length > 0 && (
          <div class="space-y-6">
            <div class="eyebrow">Certifications</div>
            {certifications.map((cert) => (
              <div class="space-y-1.5">
                <div class="font-display text-lg font-semibold tracking-tight">
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noreferrer noopener" class="link-underline">{cert.title}</a>
                  ) : (
                    cert.title
                  )}
                </div>
                <div class="font-serif text-base text-muted">{cert.issuer}{cert.note ? ` · ${cert.note}` : ""}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ── § 04 · External signal (only when populated) ── -->
    {(openSource.length > 0 || talks.length > 0) && (
      <section class="mt-24 md:mt-32">
        <div class="specimen-heading">
          <span class="num">§ 04</span>
          <span>—</span>
          <span class="text-text">External signal</span>
          <span class="sep" aria-hidden="true"></span>
          <span>{openSource.length + talks.length} entries</span>
        </div>

        <div class="mt-10 grid gap-12 md:grid-cols-2">
          {openSource.length > 0 && (
            <div class="space-y-6">
              <div class="eyebrow">Open source</div>
              {openSource.map((o) => (
                <div class="space-y-1.5">
                  <div class="font-display text-lg font-semibold tracking-tight">
                    <a href={o.url} target="_blank" rel="noreferrer noopener" class="link-underline">{o.title}</a>
                    {o.badge && (
                      <span class="ml-2 inline-block font-mono text-[10px] uppercase tracking-[0.2em] text-accent border border-accent/40 rounded-full px-2 py-0.5 align-middle">{o.badge}</span>
                    )}
                  </div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">{o.repo}</div>
                  <p class="font-serif text-base text-text/85 leading-relaxed">{o.detail}</p>
                </div>
              ))}
            </div>
          )}

          {talks.length > 0 && (
            <div class="space-y-6">
              <div class="eyebrow">Talks · writing</div>
              {talks.map((t) => (
                <div class="space-y-1.5">
                  <div class="font-display text-lg font-semibold tracking-tight">
                    {t.url ? (
                      <a href={t.url} target="_blank" rel="noreferrer noopener" class="link-underline">{t.title}</a>
                    ) : (
                      t.title
                    )}
                  </div>
                  <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">{t.venue} · {t.date}</div>
                  {t.detail && <p class="font-serif text-base text-text/85 leading-relaxed">{t.detail}</p>}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ── § 05 (or 04) · Contact ── -->
    <section class="mt-24 md:mt-32 mb-8">
      <div class="specimen-heading">
        <span class="num">§ {(openSource.length || talks.length) ? "05" : "04"}</span>
        <span>—</span>
        <span class="text-text">Contact</span>
        <span class="sep" aria-hidden="true"></span>
        <span>4 channels</span>
      </div>

      <ul class="mt-10 grid gap-x-12 gap-y-4 md:grid-cols-2">
        <li class="flex items-baseline gap-4 border-b border-border/60 pb-3">
          <span class="eyebrow w-20 shrink-0">Email</span>
          <a href={profile.socials.email} class="font-serif text-base link-underline">{profile.email}</a>
        </li>
        <li class="flex items-baseline gap-4 border-b border-border/60 pb-3">
          <span class="eyebrow w-20 shrink-0">LinkedIn</span>
          <a href={profile.socials.linkedin} target="_blank" rel="noreferrer noopener" class="font-serif text-base link-underline">{linkedinDisplay}</a>
        </li>
        <li class="flex items-baseline gap-4 border-b border-border/60 pb-3">
          <span class="eyebrow w-20 shrink-0">GitHub</span>
          <a href={profile.socials.github} target="_blank" rel="noreferrer noopener" class="font-serif text-base link-underline">{githubDisplay}</a>
        </li>
        <li class="flex items-baseline gap-4 border-b border-border/60 pb-3">
          <span class="eyebrow w-20 shrink-0">Twitter</span>
          <a href={profile.socials.twitter} target="_blank" rel="noreferrer noopener" class="font-serif text-base link-underline">@_MR_0100</a>
        </li>
      </ul>
    </section>
  </article>
</Base>

<style>
  @media print {
    nav, footer, .reveal { display: revert; }
    body { background: white; }
    .atmosphere { display: none !important; }
  }
</style>
