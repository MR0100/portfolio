---
import "~/styles/globals.css";
import SectionFX from "~/components/SectionFX.astro";
import { getCollection } from "astro:content";

const all = await getCollection("work");
const featured = all.filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order);
const pool = featured.length ? featured : all;
const imgOf = (p: any) => p?.data?.hero || p?.data?.gallery?.[0];

// Use one project with a REAL screenshot (not the hero-placeholder.svg) for every
// variant → clean UI comparison.
const real = pool.filter((p) => { const h = imgOf(p); return h && !h.includes("placeholder"); });
const P = real[0] || pool.find((p) => imgOf(p)) || pool[0];
const d = P.data;
const img = imgOf(P);
const href = `/work/${P.slug}`;
const stack: string[] = d.stack.slice(0, 5);
const gallery: string[] = (d.gallery && d.gallery.length ? d.gallery : [img, img, img, img]).filter(Boolean).slice(0, 4);
const url = d.links?.liveSite || `mitulvaghasiya.com/work/${P.slug}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Image Showcase · 10 variations</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="bg-bg text-text antialiased">
    <header class="container-page py-10">
      <p class="font-mono text-[10px] uppercase tracking-[0.28em] text-accent">Lab · image-showcase variations</p>
      <h1 class="mt-3 font-display text-3xl md:text-5xl font-semibold tracking-tight">Image Showcase · 10 ways</h1>
      <p class="mt-3 max-w-2xl font-serif text-lg text-muted">
        Ten UI/style takes on the image-forward showcase you liked — all over the Warp Starfield, all using
        the same real project so you can compare the framing. Tell me the number and I'll build it into the
        live Selected Work section (one project shown per tab, exactly like now).
      </p>
    </header>

    {/* 01 — Browser Tilt */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">01 · Browser Tilt</div>
      <div class="v2col">
        <div class="browser tilt-l">
          <div class="bar"><i></i><i></i><i></i><span class="url">{url}</span></div>
          <div class="shot scan"><img src={img} alt="" loading="lazy" /></div>
        </div>
        <div class="txt">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
      </div>
    </div></section>

    {/* 02 — Device Bezel */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">02 · Device Bezel</div>
      <div class="v2col">
        <div class="txt">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
        <div class="device tilt-r"><span class="cam"></span><div class="shot scan"><img src={img} alt="" loading="lazy" /></div></div>
      </div>
    </div></section>

    {/* 03 — Cinematic full-bleed */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">03 · Cinematic</div>
      <div class="cinema">
        <div class="shot scan"><img src={img} alt="" loading="lazy" class="cover" /></div>
        <div class="cinema-text">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      </div>
    </div></section>

    {/* 04 — Diagonal Split */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">04 · Diagonal Split</div>
      <div class="diag">
        <div class="diag-img shot scan"><img src={img} alt="" loading="lazy" class="cover" /></div>
        <div class="txt diag-text">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
      </div>
    </div></section>

    {/* 05 — Layered Stack */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">05 · Layered Stack</div>
      <div class="v2col">
        <div class="layered">
          <span class="ghost g2"></span><span class="ghost g1"></span>
          <div class="shot scan main"><img src={img} alt="" loading="lazy" /></div>
        </div>
        <div class="txt">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
      </div>
    </div></section>

    {/* 06 — Terminal Window */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">06 · Terminal</div>
      <div class="v2col">
        <div class="terminal">
          <div class="bar"><i></i><i></i><i></i><span class="url">~/{P.slug} — zsh</span></div>
          <div class="shot scan"><img src={img} alt="" loading="lazy" /></div>
        </div>
        <div class="txt mono-text">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3>
          <pre class="term-lines">{`> role  : ${d.role}
> dist  : ${[d.links?.appStore && "iOS", (d.links?.playStore || d.links?.apkPure) && "Android", d.links?.liveSite && "Web"].filter(Boolean).join(" / ") || "Internal"}
> stack : ${stack.join(", ")}`}</pre>
          <a href={href} class="cta">$ open case-study →</a>
        </div>
      </div>
    </div></section>

    {/* 07 — Editorial */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">07 · Editorial</div>
      <div class="editorial">
        <span class="ed-num">07</span>
        <div class="ed-img shot scan"><img src={img} alt="" loading="lazy" class="cover" /></div>
        <h3 class="ed-title">{d.title}</h3>
        <div class="ed-body">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
      </div>
    </div></section>

    {/* 08 — Pedestal Glow */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">08 · Pedestal Glow</div>
      <div class="pedestal">
        <div class="meta center">{d.category} · <b>{d.status}</b></div>
        <h3 class="center">{d.title}</h3>
        <p class="center narrow">{d.oneLiner}</p>
        <div class="ped-img shot scan"><img src={img} alt="" loading="lazy" /></div>
        <div class="chips center">{stack.map((s) => <span class="chip">{s}</span>)}<a href={href} class="cta">Case study →</a></div>
      </div>
    </div></section>

    {/* 09 — HUD Hologram */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">09 · HUD Hologram</div>
      <div class="v2col">
        <div class="hud">
          <span class="tk tl"></span><span class="tk tr"></span><span class="tk bl"></span><span class="tk br"></span>
          <div class="shot scan holo"><img src={img} alt="" loading="lazy" /></div>
          <span class="hud-cap">REC · {P.slug}.cap</span>
        </div>
        <div class="txt mono-text">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="hud-rows">{stack.map((s) => <span>▸ {s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
      </div>
    </div></section>

    {/* 10 — Filmstrip */}
    <section class="pv"><SectionFX variant="warp" /><div class="container-page relative z-10 w-full">
      <div class="pv-tag">10 · Filmstrip</div>
      <div class="v2col">
        <div class="film">
          <div class="shot scan film-main"><img src={img} alt="" loading="lazy" /></div>
          <div class="film-strip">{gallery.map((g) => <span class="film-cell"><img src={g} alt="" loading="lazy" /></span>)}</div>
        </div>
        <div class="txt">
          <div class="meta">{d.category} · <b>{d.status}</b></div>
          <h3>{d.title}</h3><p>{d.oneLiner}</p>
          <div class="chips">{stack.map((s) => <span class="chip">{s}</span>)}</div>
          <a href={href} class="cta">Read case study →</a>
        </div>
      </div>
    </div></section>

    <footer class="container-page py-16 text-center font-mono text-[10px] uppercase tracking-[0.28em] text-muted">
      End of reel · pick a number
    </footer>

    <style>
      .pv {
        position: relative;
        overflow: hidden;
        min-height: 92vh;
        display: flex;
        align-items: center;
        padding: 5rem 0;
        border-top: 1px solid rgb(var(--border));
        --sfx-opacity: 0.5;
      }
      .pv-tag { font-family: var(--font-mono, monospace); font-size: 11px; text-transform: uppercase; letter-spacing: 0.24em; color: rgb(var(--accent)); margin-bottom: 2.25rem; }

      /* shared text block */
      .txt { display: flex; flex-direction: column; gap: 1rem; }
      .meta { font-family: var(--font-mono, monospace); font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: rgb(var(--muted)); }
      .meta b { color: rgb(var(--accent)); font-weight: 500; }
      .txt h3, .center h3 { font-family: var(--font-display, serif); font-weight: 600; letter-spacing: -0.01em; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.04; }
      .txt p { font-family: var(--font-serif, Fraunces, serif); font-size: 1.15rem; line-height: 1.6; color: rgb(var(--muted)); max-width: 30rem; }
      .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; }
      .cta { font-family: var(--font-mono, monospace); font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: rgb(var(--accent)); }
      .center { text-align: center; }
      .narrow { margin: 0 auto; max-width: 34rem; }

      .v2col { display: grid; gap: 2.5rem; align-items: center; }
      @media (min-width: 1024px) { .v2col { grid-template-columns: 1.4fr 1fr; gap: 3.5rem; } }

      /* image frame primitives */
      .shot { position: relative; overflow: hidden; background: rgb(var(--bg) / 0.55); aspect-ratio: 16 / 10; }
      .shot img { width: 100%; height: 100%; object-fit: contain; padding: 0.9rem; display: block; }
      .shot img.cover { object-fit: cover; padding: 0; }
      .scan::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(to bottom, transparent 0 2px, rgb(var(--accent) / 0.05) 2px 3px); }

      /* 01 browser / 06 terminal chrome */
      .browser, .terminal { border: 1px solid rgb(var(--border)); border-radius: 0.6rem; overflow: hidden; background: rgb(var(--paper) / 0.5); box-shadow: 0 30px 80px rgb(0 0 0 / 0.45); }
      .tilt-l { transform: perspective(1500px) rotateY(-5deg) rotateX(2deg); transition: transform .4s ease; }
      .tilt-r { transform: perspective(1500px) rotateY(5deg) rotateX(2deg); transition: transform .4s ease; }
      .tilt-l:hover, .tilt-r:hover { transform: none; }
      .bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.8rem; border-bottom: 1px solid rgb(var(--border)); }
      .bar i { width: 9px; height: 9px; border-radius: 50%; background: rgb(var(--muted) / 0.5); }
      .url { margin-left: 0.7rem; flex: 1; font-family: var(--font-mono, monospace); font-size: 10px; color: rgb(var(--muted)); background: rgb(var(--bg) / 0.6); border-radius: 0.3rem; padding: 0.25rem 0.6rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .terminal .url { background: transparent; }

      /* 02 device */
      .device { position: relative; border: 10px solid rgb(20 26 34); border-radius: 1.6rem; overflow: hidden; background: #000; box-shadow: 0 30px 80px rgb(0 0 0 / 0.5); }
      .device .cam { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 46px; height: 6px; border-radius: 6px; background: rgb(8 10 14); z-index: 2; }
      .device .shot { border-radius: 0.9rem; }

      /* 03 cinematic */
      .cinema { position: relative; border: 1px solid rgb(var(--border)); border-radius: 0.7rem; overflow: hidden; }
      .cinema .shot { aspect-ratio: 21 / 9; }
      .cinema-text { position: absolute; inset: auto 0 0 0; padding: 2rem; display: flex; flex-direction: column; gap: 0.7rem; background: linear-gradient(to top, rgb(var(--bg)) 5%, rgb(var(--bg) / 0.7) 45%, transparent); }
      .cinema-text h3 { font-family: var(--font-display, serif); font-weight: 600; font-size: clamp(2rem, 5vw, 4rem); line-height: 1; }
      .cinema-text p { font-family: var(--font-serif, Fraunces, serif); color: rgb(var(--text) / 0.85); max-width: 34rem; }

      /* 04 diagonal */
      .diag { display: grid; align-items: center; gap: 2rem; }
      @media (min-width: 768px) { .diag { grid-template-columns: 1.2fr 1fr; gap: 0; } }
      .diag-img { aspect-ratio: 4 / 3; border: 1px solid rgb(var(--border)); }
      @media (min-width: 768px) { .diag-img { clip-path: polygon(0 0, 100% 0, 86% 100%, 0% 100%); margin-right: -8%; } }
      .diag-text { padding-left: 1rem; }

      /* 05 layered */
      .layered { position: relative; padding: 1.4rem 1.4rem 0 0; }
      .layered .main { position: relative; z-index: 2; border: 1px solid rgb(var(--border)); border-radius: 0.4rem; }
      .layered .ghost { position: absolute; inset: 0; border: 1px solid rgb(var(--border) / 0.7); border-radius: 0.4rem; background: rgb(var(--paper) / 0.3); }
      .layered .g1 { transform: translate(0.7rem, -0.7rem); z-index: 1; }
      .layered .g2 { transform: translate(1.4rem, -1.4rem); z-index: 0; opacity: 0.5; }

      /* 06 terminal text */
      .mono-text h3 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); }
      .term-lines { font-family: var(--font-mono, monospace); font-size: 12px; line-height: 1.9; color: rgb(var(--text)); white-space: pre-wrap; margin: 0.2rem 0; }

      /* 07 editorial */
      .editorial { position: relative; padding-top: 2rem; }
      .ed-num { position: absolute; top: -2rem; left: -0.5rem; font-family: var(--font-mono, monospace); font-weight: 700; font-size: 11rem; line-height: 0.8; color: rgb(var(--accent) / 0.08); pointer-events: none; }
      .ed-img { width: min(70%, 44rem); margin-left: auto; aspect-ratio: 16 / 10; border: 1px solid rgb(var(--border)); border-radius: 0.4rem; }
      .ed-title { position: relative; z-index: 3; margin-top: -3.5rem; font-family: var(--font-display, serif); font-weight: 600; font-size: clamp(2.5rem, 7vw, 6rem); line-height: 0.95; max-width: 14ch; text-shadow: 0 4px 30px rgb(var(--bg)); }
      .ed-body { margin-top: 1.2rem; display: flex; flex-direction: column; gap: 0.8rem; max-width: 32rem; }
      .ed-body p { font-family: var(--font-serif, Fraunces, serif); font-size: 1.1rem; color: rgb(var(--muted)); }

      /* 08 pedestal */
      .pedestal { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
      .ped-img { width: min(80%, 50rem); aspect-ratio: 16 / 9; border: 1px solid rgb(var(--accent) / 0.3); border-radius: 0.5rem; margin: 0.6rem 0; box-shadow: 0 0 70px rgb(var(--accent) / 0.18), 0 40px 80px rgb(0 0 0 / 0.5); position: relative; }
      .ped-img::before { content: ""; position: absolute; inset: 100% 8% auto 8%; height: 40%; background: linear-gradient(to bottom, rgb(var(--accent) / 0.12), transparent); transform: scaleY(-1); filter: blur(2px); opacity: 0.5; }
      .pedestal h3 { font-size: clamp(2rem, 4.5vw, 3.5rem); }

      /* 09 hud */
      .hud { position: relative; border: 1px solid rgb(var(--accent) / 0.35); padding: 0.6rem; background: rgb(var(--bg) / 0.4); }
      .hud .shot { aspect-ratio: 16 / 10; }
      .hud .holo::after { background: repeating-linear-gradient(to bottom, transparent 0 2px, rgb(var(--accent) / 0.12) 2px 3px); mix-blend-mode: screen; }
      .hud .holo img { filter: drop-shadow(0 0 12px rgb(var(--accent) / 0.4)) saturate(1.1); }
      .hud .tk { position: absolute; width: 14px; height: 14px; border: 2px solid rgb(var(--accent)); z-index: 3; }
      .tk.tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
      .tk.tr { top: -2px; right: -2px; border-left: 0; border-bottom: 0; }
      .tk.bl { bottom: -2px; left: -2px; border-right: 0; border-top: 0; }
      .tk.br { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }
      .hud-cap { position: absolute; top: 0.9rem; right: 1rem; z-index: 3; font-family: var(--font-mono, monospace); font-size: 9px; letter-spacing: 0.16em; color: rgb(244 63 94); }
      .hud-rows { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--font-mono, monospace); font-size: 12px; color: rgb(var(--accent)); }

      /* 10 filmstrip */
      .film-main { aspect-ratio: 16 / 9; border: 1px solid rgb(var(--border)); border-radius: 0.4rem; }
      .film-strip { display: flex; gap: 0.6rem; margin-top: 0.6rem; }
      .film-cell { flex: 1; aspect-ratio: 16 / 11; border: 1px solid rgb(var(--border)); border-radius: 0.3rem; overflow: hidden; background: rgb(var(--bg) / 0.5); transition: border-color .2s; }
      .film-cell:hover { border-color: rgb(var(--accent) / 0.5); }
      .film-cell img { width: 100%; height: 100%; object-fit: cover; }
    </style>
  </body>
</html>
