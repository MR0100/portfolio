---
import "~/styles/globals.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import BackgroundFX from "~/components/BackgroundFX.astro";
import DotGrid from "~/components/DotGrid.astro";
import { profile } from "~/data/profile";
import Analytics from "~/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = `${profile.headline}. ${profile.tagline}`,
  image = "/og-default.png",
  type = "website",
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${profile.shortName} — ${profile.headline}`
  : `${profile.shortName} — ${profile.headline}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://mitulvaghasiya.com").toString();
const ogImage = new URL(image, Astro.site ?? "https://mitulvaghasiya.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={profile.shortName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Inter + Fraunces + JetBrains Mono via Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load fonts without blocking first paint: fetch as `print` (non-render-
         blocking), then flip to `all` once ready. `display=swap` shows fallback
         text immediately. <noscript> fallback for JS-off. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Theme bootstrap: pick saved mode (light/dark) before paint to
         avoid flash. Site is Onyx-only — no variant restoration. Any
         old themeVariant in localStorage is also cleared on visit so
         stale values can't apply a non-Onyx data-theme. -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          const mode = saved || system;
          if (mode === "dark") document.documentElement.classList.add("dark");
          // Clean up legacy variant state — site is Onyx-only now.
          try { localStorage.removeItem("themeVariant"); } catch (e) {}
          document.documentElement.removeAttribute("data-theme");
        } catch (e) {}
      })();
    </script>

    <!-- Motion preference (before paint): animations are OFF BY DEFAULT for a
         calm, legible first impression. The class is applied unless the visitor
         has explicitly opted in (hero "Play animations" control, persisted in
         localStorage), so the FX engines see it on their very first init and
         never start their rAF loops on a default load. Default-off also covers
         the OS prefers-reduced-motion case automatically. -->
    <script is:inline>
      (function () {
        var optedIn = false;
        try { optedIn = localStorage.getItem("motion") === "on"; } catch (e) {}
        if (!optedIn) document.documentElement.classList.add("reduce-motion");
      })();
    </script>

    <!-- No-JS fallback: reveal animations are JS-driven, so force content visible without it -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eef2f8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#060c16" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.shortName} — Notes`} href="/rss.xml" />

    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Drifting atmospheres — fixed behind everything, GPU-cheap, reduced-motion safe -->
    <div class="atmosphere" aria-hidden="true">
      <span class="atmosphere-orb atmosphere-orb--teal"></span>
      <span class="atmosphere-orb atmosphere-orb--sepia"></span>
      <span class="atmosphere-orb atmosphere-orb--accent-soft"></span>
    </div>

    <!-- Single page-level dot-grid backdrop. Fixed to the viewport so the
         grid is continuous across every section — no per-section seams or
         empty bands. Also handles the cursor zoom/bounce sitewide. -->
    <DotGrid fixed />

    <!-- Reactive cyberpunk background: scanlines, cursor reveal, glitch sweep, HUD reticle -->
    <BackgroundFX />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>

    <!-- Nav + main + footer are pulled into a positioned layer (z-10) so
         the fixed dot-grid canvas (z-0) cleanly sits BEHIND every page
         content tree. Without this, fixed-positioned canvases paint above
         non-positioned siblings per CSS stacking rules, and the dot grid
         would render on top of text. -->
    <Nav />

    <main id="main" class="relative z-10 flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Reveal-on-scroll IntersectionObserver + sibling stagger -->
    <script is:inline>
      (function () {
        // Assign stagger index for any container marked `.reveal-stagger` — each child
        // .reveal gets its own --reveal-i so siblings animate ~60ms apart.
        document.querySelectorAll(".reveal-stagger").forEach((container) => {
          container.querySelectorAll(":scope > .reveal").forEach((el, i) => {
            el.style.setProperty("--reveal-i", i);
          });
        });

        const reduceMotion = (window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion"));
        if (reduceMotion) {
          document.querySelectorAll(".reveal").forEach((el) => el.classList.add("in-view"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      })();
    </script>

    <!-- Heading decode: scramble each [data-scramble] heading as it enters view -->
    <script is:inline>
      (function () {
        const rm = (window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion"));
        const els = document.querySelectorAll("[data-scramble]");
        if (!els.length || rm) return;
        const CH = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&/<>*+-_=01";

        const run = (el) => {
          const finalHTML = el.innerHTML;
          const finalText = el.textContent || "";
          const len = finalText.length;
          const frames = 26;
          let f = 0;
          el.classList.add("is-scrambling");
          const tick = () => {
            const reveal = Math.floor((f / frames) * len);
            let out = "";
            for (let i = 0; i < len; i++) {
              const c = finalText[i];
              if (c === " " || c === "\n") { out += c; }
              else if (i < reveal) { out += c; }
              else { out += CH[Math.floor(Math.random() * CH.length)]; }
            }
            el.textContent = out;
            f++;
            if (f <= frames) { requestAnimationFrame(tick); }
            else { el.innerHTML = finalHTML; el.classList.remove("is-scrambling"); }
          };
          requestAnimationFrame(tick);
        };

        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { io.unobserve(e.target); run(e.target); }
          }),
          { threshold: 0.6 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <!-- Hero name: occasional auto chromatic-glitch (every ~7–13s) -->
    <script is:inline>
      (function () {
        const rm = (window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion"));
        if (rm) return;
        const names = document.querySelectorAll("h1 .glitch");
        if (!names.length) return;
        const burst = () => {
          names.forEach((n, i) => {
            // stagger the lines so the glitch cascades down the name
            setTimeout(() => {
              n.classList.add("glitch-auto");
              setTimeout(() => n.classList.remove("glitch-auto"), 480);
            }, i * 90);
          });
          setTimeout(burst, 7000 + Math.random() * 6000);
        };
        setTimeout(burst, 4000 + Math.random() * 4000);
      })();
    </script>

    <!-- Tag every interactive element for the encryption / decode hover:
         text links/buttons get the JS scramble (.encrypt-tap), complex
         icon-only tappables get a soft accent glow (.glitch-hover).
         The hero <h1> still uses the manual chromatic-slice .glitch. -->
    <script is:inline>
      (function () {
        if ((window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion"))) return;
        document.querySelectorAll("a, button, [role='button']").forEach((el) => {
          if (el.closest("[data-drones], [data-breach]")) return;
          if (el.classList.contains("glitch") || el.classList.contains("encrypt-tap") || el.classList.contains("glitch-hover")) return;
          const txt = (el.textContent || "").trim().replace(/\s+/g, " ");
          const hasGfx = el.querySelector("img, svg, picture, video, canvas");
          // Tap labels short enough to scramble cleanly without layout jump.
          if (txt && txt.length <= 42 && !hasGfx) {
            el.setAttribute("data-text", txt);
            el.classList.add("encrypt-tap");
          } else {
            el.classList.add("glitch-hover");
          }
        });
      })();
    </script>

    <!-- ─────────── Encryption / Decode hover engine ───────────
         When a .encrypt-tap element is hovered, scramble its visible text
         through a cipher charset, then progressively reveal the real label
         from left to right. Each scrambled character is wrapped in a span
         tinted with the GLITCH PALETTE — accent (teal/blue) / red / white
         — chosen per-frame at random. Resolved characters return to the
         element's natural color. Original text restored on completion.

         Timing: ~22 frames × ~28ms = ~620ms total. Reveal starts at frame
         6 (so the eye reads "encryption" first) and finishes at frame 22.
         Spaces and non-letter chars stay in place — they don't scramble. -->
    <script is:inline>
      (function () {
        if ((window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion"))) return;
        const CIPHER = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789!@#$%&*<>{}[]_/\\";
        const FRAMES = 22;
        const FRAME_MS = 28;
        const REVEAL_START = 6;
        // Per-char channel weights — accent dominates, red + white punctuate.
        const CHANNELS = ["enc-c1", "enc-c1", "enc-c1", "enc-c2", "enc-c3"];

        const randChar = () => CIPHER[Math.floor(Math.random() * CIPHER.length)];
        const randChannel = () => CHANNELS[Math.floor(Math.random() * CHANNELS.length)];
        const escapeHTML = (s) => s.replace(/[&<>"']/g, (c) => (
          { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c]
        ));

        // Measure the rendered width of each character in `text` as it would
        // render INSIDE this element (same font, weight, letter-spacing).
        // Used to pin each cipher span to the original glyph's width so the
        // scramble never widens or narrows the label.
        function measureCharWidths(el, text) {
          const probe = document.createElement("span");
          const cs = getComputedStyle(el);
          probe.style.cssText =
            "visibility:hidden;position:absolute;left:-9999px;top:0;" +
            "white-space:pre;pointer-events:none;";
          probe.style.fontFamily = cs.fontFamily;
          probe.style.fontSize = cs.fontSize;
          probe.style.fontWeight = cs.fontWeight;
          probe.style.fontStyle = cs.fontStyle;
          probe.style.letterSpacing = cs.letterSpacing;
          probe.style.textTransform = cs.textTransform;
          probe.style.fontVariantCaps = cs.fontVariantCaps;
          // Render the WHOLE label so per-char widths include their share
          // of letter-spacing. Measuring one char at a time would miss the
          // spacing and the scramble would drift wider than the original.
          probe.textContent = text;
          document.body.appendChild(probe);

          const widths = new Array(text.length);
          const range = document.createRange();
          const node = probe.firstChild;
          for (let i = 0; i < text.length; i++) {
            range.setStart(node, i);
            range.setEnd(node, i + 1);
            widths[i] = range.getBoundingClientRect().width;
          }
          document.body.removeChild(probe);
          return widths;
        }

        function scramble(el) {
          if (el.__encryptId) return;
          const real = el.getAttribute("data-text") || el.textContent.trim();
          if (!real) return;

          // ── Inner-span lock (flex-safe) ──
          // We DON'T set width on the button itself — that fights with
          // flex containers (the box collapses to its padding when the
          // inner spans don't intrinsically size). Instead we wrap all
          // scrambled content in a SINGLE inline-block span pinned to
          // exactly the natural inner-content width AND height. The
          // button keeps its natural size; the wrapper holds the
          // scramble + clips. Height lock is critical: inline-block with
          // overflow:hidden shifts its baseline behavior, which would
          // otherwise push the parent line taller.
          const dims = measureInner(el, real);
          el.__encryptInnerWidth = dims.width;
          el.classList.add("is-encrypting");

          // Capture the parent's line-height once so the wrapper inherits
          // exactly the same vertical metric every frame.
          const cs = getComputedStyle(el);
          const lineHeight = cs.lineHeight === "normal"
            ? (parseFloat(cs.fontSize) * 1.2).toFixed(2) + "px"
            : cs.lineHeight;

          let frame = 0;
          el.__encryptId = setInterval(() => {
            frame++;
            const t = Math.max(0, frame - REVEAL_START) / (FRAMES - REVEAL_START);
            const revealed = Math.floor(real.length * Math.min(1, t));
            let inner = "";
            for (let i = 0; i < real.length; i++) {
              const c = real[i];
              if (i < revealed || c === " " || /[^A-Za-z0-9]/.test(c)) {
                inner += escapeHTML(c);
              } else {
                const ch = randChar();
                const cls = randChannel();
                inner += '<span class="' + cls + '">' + escapeHTML(ch) + "</span>";
              }
            }
            el.innerHTML =
              '<span class="enc-wrap" style="display:inline-block;' +
              'width:' + dims.width.toFixed(2) + 'px;' +
              'height:' + dims.height.toFixed(2) + 'px;' +
              'line-height:' + lineHeight + ';' +
              'overflow:hidden;white-space:nowrap;text-align:left;' +
              'vertical-align:middle">' +
              inner + "</span>";
            if (frame >= FRAMES) finish(el);
          }, FRAME_MS);
        }

        // Measure the rendered width AND height of the full label string
        // using the element's exact font metrics + line-height. The
        // wrapper is pinned to BOTH so the button never grows in either
        // axis during scramble.
        function measureInner(el, text) {
          const probe = document.createElement("span");
          const cs = getComputedStyle(el);
          probe.style.cssText =
            "visibility:hidden;position:absolute;left:-9999px;top:0;" +
            "white-space:pre;pointer-events:none;display:inline-block;";
          probe.style.fontFamily = cs.fontFamily;
          probe.style.fontSize = cs.fontSize;
          probe.style.fontWeight = cs.fontWeight;
          probe.style.fontStyle = cs.fontStyle;
          probe.style.letterSpacing = cs.letterSpacing;
          probe.style.textTransform = cs.textTransform;
          probe.style.fontVariantCaps = cs.fontVariantCaps;
          probe.style.lineHeight = cs.lineHeight;
          probe.textContent = text;
          document.body.appendChild(probe);
          const r = probe.getBoundingClientRect();
          document.body.removeChild(probe);
          return { width: r.width, height: r.height };
        }

        function finish(el) {
          if (!el.__encryptId) return;
          clearInterval(el.__encryptId);
          el.__encryptId = null;
          // Restore plain text — strips the wrapper + cipher spans cleanly.
          el.textContent = el.getAttribute("data-text") || el.textContent;
          el.classList.remove("is-encrypting");
          delete el.__encryptInnerWidth;
        }

        // Don't scramble when the user is starting/finishing a tap — keeps
        // the click target stable. As soon as pointerdown lands on a button,
        // we set a guard and clear it on pointerup. While the guard is set,
        // mouseenter / focusin don't start a new scramble.
        let interactingEl = null;
        document.addEventListener("pointerdown", (e) => {
          const el = e.target.closest && e.target.closest(".encrypt-tap");
          if (!el) return;
          interactingEl = el;
          // Already scrambling? Resolve immediately so the user sees the
          // real label they're tapping on.
          if (el.__encryptId) finish(el);
        }, true);
        document.addEventListener("pointerup",   () => { interactingEl = null; }, true);
        document.addEventListener("pointercancel",() => { interactingEl = null; }, true);

        // Delegate from document so dynamically-added buttons work too.
        // NOTE: hover-only by design. We deliberately do NOT scramble on
        // `focusin` — mutating an element's text while it's focused corrupts
        // the accessible name a screen reader announces (it would read cipher
        // gibberish). Keyboard users get the stable label + focus ring.
        document.addEventListener("mouseenter", (e) => {
          const el = e.target.closest && e.target.closest(".encrypt-tap");
          if (!el || el === interactingEl) return;
          scramble(el);
        }, true);
      })();
    </script>

    <!-- One shared IST clock — updates every [data-ist-clock] element. Replaces
         three byte-identical per-component scripts (drift-proof; one timer). -->
    <script is:inline>
      (function () {
        const clocks = document.querySelectorAll("[data-ist-clock]");
        if (!clocks.length) return;
        const fmt = new Intl.DateTimeFormat("en-GB", {
          timeZone: "Asia/Kolkata",
          hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
        });
        const tick = () => {
          const t = fmt.format(new Date());
          clocks.forEach((el) => { el.textContent = t; });
        };
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
