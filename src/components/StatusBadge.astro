---
interface Props {
  status: "verified" | "brand-verified" | "internal" | "unlisted" | "early";
}

const { status } = Astro.props;

const config: Record<Props["status"], { label: string; tone: string }> = {
  "verified": {
    label: "Verified · in stores",
    tone: "border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
  },
  "brand-verified": {
    label: "Client brand verified",
    tone: "border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-400",
  },
  "internal": {
    label: "Internal / private",
    tone: "border-border bg-surface text-muted",
  },
  "unlisted": {
    label: "Was on stores · now delisted",
    tone: "border-border bg-surface text-muted",
  },
  "early": {
    label: "Earlier work",
    tone: "border-border bg-surface text-muted",
  },
};

const { label, tone } = config[status];
---

<span class:list={["inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-medium tracking-wide", tone]}>
  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9.5"></circle>
  </svg>
  {label}
</span>
