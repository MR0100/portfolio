---
// Compact row of available-store icons. Used on grid cards so distribution
// is visible at a glance without opening the case study.
interface Props {
  links: {
    appStore?: string;
    playStore?: string;
    liveSite?: string;
    apkPure?: string;
    github?: string;
    press?: string[];
  };
  size?: "sm" | "md";
}

const { links, size = "sm" } = Astro.props;
const dim = size === "md" ? "h-4 w-4" : "h-3.5 w-3.5";
const chip = size === "md" ? "h-7 w-7" : "h-6 w-6";

type Entry = { key: string; href: string; label: string; svg: string };
const items: Entry[] = [];

if (links.appStore) items.push({
  key: "app-store",
  href: links.appStore,
  label: "App Store",
  svg: `<path d="M17.5 12.5c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-2-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.9c-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.3 2.5 1.3-.1 1.8-.9 3.4-.9s2 .9 3.4.8c1.4 0 2.3-1.2 3.2-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-3.9zM15 5.3c.7-.8 1.1-2 1-3.1-.9.1-2 .6-2.7 1.4-.6.7-1.2 1.9-1 3 1 .1 2-.5 2.7-1.3z"/>`,
});
if (links.playStore) items.push({
  key: "play-store",
  href: links.playStore,
  label: "Play Store",
  svg: `<path d="M3 2.5v19a1 1 0 0 0 1.6.8L19 12 4.6 1.7A1 1 0 0 0 3 2.5z"/>`,
});
if (links.apkPure) items.push({
  key: "apk-pure",
  href: links.apkPure,
  label: "APKPure mirror",
  svg: `<rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 16V8l7 4-7 4z" fill="currentColor"/>`,
});
if (links.liveSite) items.push({
  key: "live",
  href: links.liveSite,
  label: "Live site",
  svg: `<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 12h18M12 3a13 13 0 0 1 0 18M12 3a13 13 0 0 0 0 18" fill="none" stroke="currentColor" stroke-width="2"/>`,
});
if (links.github) items.push({
  key: "github",
  href: links.github,
  label: "GitHub",
  svg: `<path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.3-1.1.6-1.3-2.2-.3-4.5-1.1-4.5-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.5 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/>`,
});
if (links.press && links.press.length > 0) items.push({
  key: "press",
  href: links.press[0],
  label: "Press / write-up",
  svg: `<path d="M4 4h12a2 2 0 0 1 2 2v10m2-6v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 8h6M8 12h6M8 16h4" stroke="currentColor" stroke-width="2"/>`,
});
---

{items.length > 0 && (
  <div class="flex items-center gap-1">
    {items.map((it) => (
      <a
        href={it.href}
        target="_blank"
        rel="noreferrer noopener"
        title={it.label}
        aria-label={it.label}
        class:list={[
          chip,
          "inline-flex items-center justify-center rounded-full border border-border bg-bg/60 text-muted hover:border-accent/40 hover:text-accent hover:bg-accent/5 transition-colors"
        ]}
        onclick="event.stopPropagation()"
      >
        <svg class={dim} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={it.svg} />
      </a>
    ))}
  </div>
)}
