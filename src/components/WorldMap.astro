---
import { getCollection } from "astro:content";

interface Props {
  variant?: "hero" | "card";
}

const { variant = "hero" } = Astro.props;

const work = await getCollection("work");
const located = work.filter((e) => e.data.lat !== undefined && e.data.lng !== undefined);

const W = 1000;
const H = 500;

const project = (lat: number, lng: number) => ({
  x: ((lng + 180) / 360) * W,
  y: ((90 - lat) / 180) * H,
});

// Aggregate by location so multiple projects in the same city share one marker.
type LocationBucket = {
  lat: number;
  lng: number;
  city: string;
  country: string;
  count: number;
  titles: string[];
  region: string;
};
const byLocation = new Map<string, LocationBucket>();
for (const entry of located) {
  const key = `${entry.data.lat},${entry.data.lng}`;
  if (!byLocation.has(key)) {
    byLocation.set(key, {
      lat: entry.data.lat!,
      lng: entry.data.lng!,
      city: entry.data.city ?? "",
      country: entry.data.country ?? "",
      count: 0,
      titles: [],
      region: entry.data.region,
    });
  }
  const bucket = byLocation.get(key)!;
  bucket.count++;
  bucket.titles.push(entry.data.title);
}

const markers = Array.from(byLocation.values()).map((b) => ({
  ...b,
  ...project(b.lat, b.lng),
}));

// Surat is the base / home — most foreign projects can trace a line back to it.
const HOME_LAT = 21.1702;
const HOME_LNG = 72.8311;
const home = project(HOME_LAT, HOME_LNG);

// Curve from home to each non-home marker as a quadratic bezier, control point pulled north.
const arcs = markers
  .filter((m) => !(m.lat === HOME_LAT && m.lng === HOME_LNG))
  .map((m) => {
    const mx = (home.x + m.x) / 2;
    const my = (home.y + m.y) / 2;
    const dist = Math.hypot(m.x - home.x, m.y - home.y);
    const lift = Math.min(110, dist * 0.28);
    const cy = my - lift;
    return {
      d: `M ${home.x} ${home.y} Q ${mx} ${cy} ${m.x} ${m.y}`,
      to: m.city || m.country,
    };
  });

// Meridian + parallel grid
const meridians = [-150, -120, -90, -60, -30, 0, 30, 60, 90, 120, 150];
const parallels = [-60, -30, 0, 30, 60];

const isHero = variant === "hero";
---

<figure class:list={["relative", isHero ? "" : "rounded-lg overflow-hidden"]}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="w-full h-auto"
    role="img"
    aria-label="World map showing project locations: Surat, Toronto, Berlin, Seoul, Tokyo"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <pattern id="dots" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.7" fill="rgb(var(--muted))" fill-opacity="0.18" />
      </pattern>

      <radialGradient id="marker-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="rgb(var(--accent))" stop-opacity="0.6" />
        <stop offset="100%" stop-color="rgb(var(--accent))" stop-opacity="0" />
      </radialGradient>

      <filter id="soft-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Paper / dot grid backdrop -->
    <rect x="0" y="0" width={W} height={H} fill="url(#dots)" />

    <!-- Latitude / longitude lines — very faint -->
    <g stroke="rgb(var(--muted))" stroke-opacity="0.10" stroke-dasharray="2 5" stroke-width="0.5">
      {meridians.map((lng) => {
        const x = ((lng + 180) / 360) * W;
        return <line x1={x} y1={0} x2={x} y2={H} />;
      })}
      {parallels.map((lat) => {
        const y = ((90 - lat) / 180) * H;
        return <line x1={0} y1={y} x2={W} y2={y} />;
      })}
      <line x1={0} y1={H / 2} x2={W} y2={H / 2} stroke-opacity="0.18" stroke-dasharray="6 6" />
    </g>

    <!-- Continent paths — intentionally simplified, evocative not precise -->
    <g
      fill="rgb(var(--muted))"
      fill-opacity="0.12"
      stroke="rgb(var(--muted))"
      stroke-opacity="0.45"
      stroke-width="0.6"
      stroke-linejoin="round"
    >
      <!-- North America -->
      <path d="M 165 70 Q 145 100 155 140 Q 175 175 200 195 Q 240 220 285 210 Q 320 195 340 165 Q 360 130 350 95 Q 320 65 270 65 Q 220 60 165 70 Z M 245 230 Q 260 250 290 245 Q 305 235 295 220 Q 270 215 245 230 Z" />
      <!-- Greenland hint -->
      <path d="M 360 55 Q 380 50 395 65 Q 395 85 375 90 Q 360 80 360 55 Z" />
      <!-- South America -->
      <path d="M 290 245 Q 275 270 285 310 Q 295 360 320 405 Q 340 425 355 410 Q 370 370 365 320 Q 360 285 345 260 Q 320 240 290 245 Z" />
      <!-- Europe -->
      <path d="M 485 105 Q 470 130 495 150 Q 525 160 555 145 Q 575 130 570 110 Q 540 95 510 100 Q 490 100 485 105 Z" />
      <!-- Africa -->
      <path d="M 510 170 Q 490 200 500 250 Q 510 305 540 365 Q 570 400 595 390 Q 615 360 615 310 Q 605 250 595 215 Q 580 180 555 170 Q 530 165 510 170 Z" />
      <!-- Asia (mainland) -->
      <path d="M 580 105 Q 575 90 615 90 Q 680 80 750 95 Q 820 100 870 120 Q 895 145 880 175 Q 855 200 810 210 Q 745 215 690 200 Q 640 185 605 165 Q 580 145 580 105 Z" />
      <!-- India peninsula tail -->
      <path d="M 690 200 Q 700 230 715 250 Q 720 270 705 270 Q 690 245 685 220 Z" />
      <!-- Southeast Asia / Indonesia -->
      <path d="M 800 250 Q 815 245 830 255 Q 820 270 805 268 Z M 835 270 Q 855 265 870 275 Q 860 290 840 285 Z" />
      <!-- Japan -->
      <path d="M 880 160 Q 895 155 900 175 Q 890 195 880 185 Z" />
      <!-- Australia -->
      <path d="M 830 330 Q 815 340 825 365 Q 855 385 895 380 Q 910 365 905 345 Q 870 320 830 330 Z" />
      <!-- New Zealand -->
      <path d="M 930 390 Q 940 388 942 400 Q 935 408 928 402 Z" />
    </g>

    <!-- Arc connections from Surat to international hubs -->
    <g fill="none" stroke="rgb(var(--accent))" stroke-opacity="0.35" stroke-width="0.9" stroke-linecap="round">
      {arcs.map((a) => (
        <path d={a.d} stroke-dasharray="3 4">
          <animate
            attributeName="stroke-dashoffset"
            from="0"
            to="-14"
            dur="3s"
            repeatCount="indefinite"
          />
        </path>
      ))}
    </g>

    <!-- Project markers -->
    <g>
      {markers.map((m) => (
        <g transform={`translate(${m.x} ${m.y})`} class="cursor-default">
          <!-- Outer pulse -->
          <circle r="3" class="map-marker-pulse" />
          <!-- Glow -->
          <circle r="14" fill="url(#marker-glow)" />
          <!-- Solid marker -->
          <circle r={3.2 + Math.min(m.count, 4) * 0.6} class="map-marker" filter="url(#soft-glow)" />
          <!-- Label -->
          <g transform="translate(8 4)">
            <text
              font-family="ui-monospace, JetBrains Mono, monospace"
              font-size="9"
              font-weight="600"
              letter-spacing="0.5"
              fill="rgb(var(--text))"
            >
              {(m.city || m.country).toUpperCase()}
            </text>
            <text
              y="11"
              font-family="ui-monospace, JetBrains Mono, monospace"
              font-size="8"
              fill="rgb(var(--muted))"
            >
              {m.count} {m.count === 1 ? "project" : "projects"}
            </text>
          </g>
        </g>
      ))}
    </g>

    <!-- Compass rose, bottom-right -->
    <g transform={`translate(${W - 60} ${H - 60})`} opacity="0.55">
      <circle r="22" fill="none" stroke="rgb(var(--muted))" stroke-width="0.6" stroke-opacity="0.4" />
      <circle r="16" fill="none" stroke="rgb(var(--muted))" stroke-width="0.5" stroke-opacity="0.3" />
      <path d="M 0 -22 L 3 0 L 0 22 L -3 0 Z" fill="rgb(var(--accent))" fill-opacity="0.7" />
      <path d="M -22 0 L 0 3 L 22 0 L 0 -3 Z" fill="rgb(var(--muted))" fill-opacity="0.4" />
      <text y="-26" text-anchor="middle" font-family="ui-serif, Georgia, serif" font-size="9" font-weight="600" fill="rgb(var(--muted))">N</text>
    </g>

    <!-- Scale label, bottom-left -->
    <g transform={`translate(40 ${H - 28})`} opacity="0.55">
      <text font-family="ui-monospace, JetBrains Mono, monospace" font-size="8" letter-spacing="2" fill="rgb(var(--muted))">EQUIRECTANGULAR · ATLAS OF WORK</text>
    </g>
  </svg>
</figure>
