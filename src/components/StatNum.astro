---
interface Props {
  value: string | number;
  label: string;
  sublabel?: string;
}

const { value, label, sublabel } = Astro.props;
---

<div class="space-y-1.5">
  <div class="stat-label">{label}</div>
  <div class="stat-num">{value}</div>
  {sublabel && <div class="stat-label text-muted/70">{sublabel}</div>}
</div>
