---
interface Props {
  href: string;
  label: string;
  kind?: "app-store" | "play-store" | "live" | "github" | "apk-pure" | "press";
}

const { href, label, kind = "live" } = Astro.props;

const icons: Record<NonNullable<Props["kind"]>, string> = {
  "app-store": `<path d="M17.5 12.5c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-2-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.9c-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.3 2.5 1.3-.1 1.8-.9 3.4-.9s2 .9 3.4.8c1.4 0 2.3-1.2 3.2-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-3.9zM15 5.3c.7-.8 1.1-2 1-3.1-.9.1-2 .6-2.7 1.4-.6.7-1.2 1.9-1 3 1 .1 2-.5 2.7-1.3z"/>`,
  "play-store": `<path d="M3 2.5v19a1 1 0 0 0 1.6.8L19 12 4.6 1.7A1 1 0 0 0 3 2.5zM13.7 13.4L5.5 21.6 16.3 15zM5.5 2.4l8.2 8.2L16.3 9zM17.4 9.5l3.2 1.8c.6.3.6 1.1 0 1.4l-3.2 1.8L14.3 12z"/>`,
  "live": `<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7.1 7.1l1.7-1.7"/>`,
  "github": `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.5c3-.3 6.2-1.5 6.2-6.6 0-1.3-.5-2.5-1.4-3.4.4-1.1.4-2.3 0-3.4 0 0-1.1-.3-3.7 1.4a12.7 12.7 0 0 0-6.6 0C6.5 1.4 5.4 1.7 5.4 1.7c-.4 1.1-.4 2.3 0 3.4A4.9 4.9 0 0 0 4 8.5c0 5 3.2 6.3 6.2 6.6-.4.4-.7.9-.8 1.5-.2.6-.2 1.1 0 1.7v3"/>`,
  "apk-pure": `<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 17V7l8 5-8 5z"/>`,
  "press": `<path d="M4 4h12a2 2 0 0 1 2 2v10m2-6v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4zM8 8h6M8 12h6M8 16h4"/>`,
};

const icon = icons[kind];
---

<a
  href={href}
  target="_blank"
  rel="noreferrer noopener"
  class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-1.5 text-xs font-medium text-text hover:border-accent/40 hover:bg-accent/5 hover:text-accent transition-colors"
>
  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
  {label}
  <svg class="h-3 w-3 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 17 17 7M7 7h10v10"/>
  </svg>
</a>
