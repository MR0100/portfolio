---
import { getCollection } from "astro:content";
import StatusBadge from "~/components/StatusBadge.astro";
import StoreLinksRow from "~/components/StoreLinksRow.astro";

const all = await getCollection("work");
const featured = all
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const distribution = (links: typeof featured[number]["data"]["links"]) =>
  [
    links.appStore && "iOS",
    (links.playStore || links.apkPure) && "Android",
    links.liveSite && "Web",
  ]
    .filter(Boolean)
    .join(" / ") || "Internal";

const N = featured.length;
---

<section class="picks">
  <!-- Section header — Museum Plate composition (centered exhibition wall text) -->
  <header class="container-page picks-plate reveal">
    <div class="picks-plate-frame">
      <div class="picks-plate-overline">Plates 01 — {String(N).padStart(2, "0")}</div>
      <h2 class="picks-plate-h2 font-display" data-scramble>
        A few I'm proud of<span class="text-accent">.</span>
      </h2>
      <div class="picks-plate-meta">
        <span>Featured projects · 2019 — 2026 · case-study format</span>
        <span class="picks-plate-meta-sep" aria-hidden="true">·</span>
        <a href="/work" class="picks-plate-link">All {all.length} projects →</a>
      </div>
      <div class="picks-plate-ornament" aria-hidden="true">✦</div>
    </div>
  </header>

  <!-- 6 featured projects, alternating layout -->
  <div class="container-page picks-grid reveal-stagger">
    {featured.map((entry, i) => {
      const d = entry.data;
      const img = d.hero || d.gallery[0];
      const num = String(i + 1).padStart(2, "0");
      return (
        <article class="pick reveal" id={`pick-${i}`} data-pick={i}>
          <div class="pick-num" aria-hidden="true">{num}</div>

          <a class="pick-shot" href={`/work/${entry.slug}`} aria-label={`Read case study: ${d.title}`}>
            {img && <img src={img} alt={`${d.title} screenshot`} loading="lazy" decoding="async" />}
            <div class="pick-shot-corner pick-shot-corner--tl"></div>
            <div class="pick-shot-corner pick-shot-corner--tr"></div>
            <div class="pick-shot-corner pick-shot-corner--bl"></div>
            <div class="pick-shot-corner pick-shot-corner--br"></div>
          </a>

          <div class="pick-text">
            <div class="pick-meta">
              <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">{d.category}</span>
              <span class="pick-meta-sep">·</span>
              <StatusBadge status={d.status} />
            </div>

            <h3 class="pick-title font-display font-semibold tracking-tight">
              <a href={`/work/${entry.slug}`}>{d.title}</a>
            </h3>

            <p class="pick-line font-serif text-muted">{d.oneLiner}</p>

            <dl class="pick-specs">
              <div><dt>Role</dt><dd>{d.role}</dd></div>
              <div><dt>Stack</dt><dd>{d.stack.slice(0, 4).join(" · ")}{d.stack.length > 4 ? ` · +${d.stack.length - 4}` : ""}</dd></div>
              <div><dt>Distrib.</dt><dd>{distribution(d.links)}</dd></div>
            </dl>

            <div class="pick-actions">
              <a class="pick-cta" href={`/work/${entry.slug}`}>
                Read case study
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
              </a>
              <span class="pick-store">
                <StoreLinksRow links={d.links} size="md" />
              </span>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .picks {
    position: relative;
    padding: 3rem 0 5rem;
    isolation: isolate;
    /* Contain the parallax-translating dot grid so it can't bleed into the
       adjacent Track (Experience) section below. */
    overflow: hidden;
  }
  @media (min-width: 900px) { .picks { padding: 4rem 0 7rem; } }

  /* DotGrid component handles its own fade (14% via the `fade` prop) and
     z-index (-1). Nothing to wire here. */

  /* ───── Museum Plate header (centered exhibition wall text) ───── */
  .picks-plate {
    text-align: center;
  }
  .picks-plate-frame {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0.5rem 1rem 0;
    position: relative;
  }
  .picks-plate-overline {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgb(var(--sepia));
  }
  .picks-plate-h2 {
    margin: 2rem 0 1.5rem;
    font-family: var(--font-display, ui-serif, serif);
    font-weight: 500;
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: rgb(var(--text));
  }
  .picks-plate-meta {
    font-family: var(--font-serif, ui-serif, serif);
    font-style: italic;
    font-size: 1rem;
    color: rgb(var(--muted));
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.6rem;
  }
  .picks-plate-meta-sep {
    color: rgb(var(--muted) / 0.5);
    font-style: normal;
  }
  .picks-plate-link {
    font-style: normal;
    font-family: ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--accent));
    transition: color 200ms ease, gap 200ms ease;
    padding-bottom: 1px;
    border-bottom: 1px solid rgb(var(--accent) / 0.4);
  }
  .picks-plate-link:hover {
    color: rgb(var(--text));
    border-bottom-color: rgb(var(--text) / 0.6);
  }
  .picks-plate-ornament {
    margin: 2rem 0;
    font-size: 1.2rem;
    color: rgb(var(--accent));
    letter-spacing: 0.6em;
  }
  @media (max-width: 540px) {
    .picks-plate-meta {
      flex-direction: column;
      gap: 0.4rem;
    }
    .picks-plate-meta-sep { display: none; }
  }

  /* ───── Project list ───── */
  .picks-grid {
    margin-top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }
  @media (min-width: 900px) { .picks-grid { gap: 11rem; margin-top: 7rem; } }

  /* Each project block */
  .pick {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    gap: 2rem;
    isolation: isolate;
  }
  @media (min-width: 900px) {
    .pick {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto;
      gap: 4.5rem;
      align-items: center;
    }
    /* Alternate layout — even rows put image on the right */
    .pick:nth-child(even) .pick-shot { order: 2; }
    .pick:nth-child(even) .pick-text { order: 1; }
  }

  /* No full-card overlay. Clickable targets are explicit: the image, the title,
     and the "Read case study" CTA. Eliminates the previous mystery hover-area
     between image and text that confused users. */

  /* Big number watermark — positioned per layout, parallaxes on scroll (see script below) */
  .pick-num {
    position: absolute;
    z-index: 0;
    top: -2.2rem;
    left: -0.3rem;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    font-size: clamp(5rem, 9vw, 9rem);
    line-height: 0.8;
    color: rgb(var(--accent) / 0.09);
    pointer-events: none;
    user-select: none;
    will-change: transform;
    transition: color 220ms ease;
  }
  .pick:hover .pick-num { color: rgb(var(--accent) / 0.14); }
  @media (min-width: 900px) {
    .pick:nth-child(even) .pick-num {
      left: auto;
      right: -0.3rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pick-num { transform: none !important; }
  }

  /* ───── Image block ───── */
  .pick-shot {
    position: relative;
    z-index: 2;
    aspect-ratio: 16 / 10;
    border: 1px solid rgb(var(--border));
    border-radius: 0.55rem;
    overflow: hidden;
    background: rgb(var(--paper) / 0.55);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.28), 0 0 0 1px rgb(var(--border) / 0.5);
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 380ms ease, border-color 380ms ease;
  }
  .pick:hover .pick-shot {
    transform: translateY(-4px);
    border-color: rgb(var(--accent) / 0.5);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.4), 0 0 0 1px rgb(var(--accent) / 0.35);
  }
  .pick-shot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.25rem;
    display: block;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pick:hover .pick-shot img { transform: scale(1.025); }

  /* Decorative corner ticks — give the photo a "framed plate" feel */
  .pick-shot-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgb(var(--accent) / 0.55);
    border-style: solid;
    border-width: 0;
    opacity: 0;
    transition: opacity 280ms ease;
    pointer-events: none;
  }
  .pick:hover .pick-shot-corner { opacity: 1; }
  .pick-shot-corner--tl { top: 8px; left: 8px; border-top-width: 1.5px; border-left-width: 1.5px; }
  .pick-shot-corner--tr { top: 8px; right: 8px; border-top-width: 1.5px; border-right-width: 1.5px; }
  .pick-shot-corner--bl { bottom: 8px; left: 8px; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .pick-shot-corner--br { bottom: 8px; right: 8px; border-bottom-width: 1.5px; border-right-width: 1.5px; }

  /* ───── Text block ───── */
  .pick-text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-width: 0;
  }

  .pick-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .pick-meta-sep {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    color: rgb(var(--muted) / 0.6);
  }

  .pick-title {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.0;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .pick-title a {
    color: rgb(var(--text));
    transition: color 220ms ease;
    display: inline;
  }
  .pick-title a:hover { color: rgb(var(--accent)); }

  .pick-line {
    font-size: 1.08rem;
    line-height: 1.55;
    max-width: 32rem;
    margin: 0;
  }

  /* Spec rows — Role / Stack / Distrib in a compact key-value list */
  .pick-specs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.875rem;
  }
  .pick-specs > div {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .pick-specs dt {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--sepia));
    margin: 0;
  }
  .pick-specs dd {
    font-family: var(--font-serif, ui-serif, serif);
    color: rgb(var(--text) / 0.9);
    margin: 0;
    min-width: 0;
  }

  /* Action row */
  .pick-actions {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
  }
  .pick-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--accent));
    transition: gap 220ms cubic-bezier(0.22, 1, 0.36, 1), color 200ms ease;
    padding: 0.4rem 0;
  }
  .pick-cta svg {
    width: 14px;
    height: 14px;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pick-cta:hover { gap: 0.85rem; color: rgb(var(--text)); }
  .pick-cta:hover svg { transform: translateX(4px); }
  .pick-store {
    /* StoreLinksRow already styled — just ensure it stays clickable */
    display: inline-flex;
    align-items: center;
  }
</style>

<script is:inline>
  // Scroll parallax on the .pick-num watermarks — numbers drift slower than the content,
  // giving the section a sense of depth without scripted card animations.
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const picks = document.querySelectorAll(".pick");
    if (!picks.length) return;

    const FACTOR = 0.22; // 0 = no parallax, 1 = number scrolls opposite to content.
    const MAX_OFFSET = 90;  // px — cap so off-screen picks don't fly the number into other sections.

    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      picks.forEach((pick) => {
        const num = pick.querySelector(".pick-num");
        if (!num) return;
        const rect = pick.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        // Negative when pick is below viewport center; positive when above.
        // Number translates *opposite* to scroll direction → reads as "anchored slower."
        let offset = (vh / 2 - center) * FACTOR;
        // Cap so the watermark can't escape its parent pick when far off-screen.
        if (offset > MAX_OFFSET) offset = MAX_OFFSET;
        else if (offset < -MAX_OFFSET) offset = -MAX_OFFSET;
        num.style.transform = "translate3d(0," + offset.toFixed(1) + "px,0)";
      });
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    update();
  })();
</script>
