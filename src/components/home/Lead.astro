---
import { profile } from "~/data/profile";
import CyberDrones from "~/components/CyberDrones.astro";

const positionWords = profile.headline.split(" ");
const rotators = ["Flutter", "Kotlin", "Swift", "Compose"];
---

<section data-game-host class="relative overflow-hidden flex min-h-[calc(100svh_-_4rem)] flex-col">
  <!-- The spacewar game lives ONLY in the hero, behind the text, and scrolls with it.
       The engine shuts off when the hero leaves the viewport. (The dot-grid is the
       parallaxing .grid-zone layer in index.astro, spanning the first three sections.) -->
  <CyberDrones />

  <!-- Main content — vertically centered in the viewport -->
  <div class="container-page flex flex-1 flex-col justify-center py-12">
    <!-- Top-left meta -->
    <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5 flicker">
        <span class="relative inline-flex h-2 w-2">
          <span class="absolute inset-0 rounded-full bg-accent/40 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Available for senior roles
      </span>
      <span aria-hidden="true">·</span>
      <span>{profile.location}</span>
    </div>

    <!-- Position — the big headline, glitches per word -->
    <h1 class="mt-8 md:mt-10 font-display font-semibold tracking-tight leading-[1.05] text-[clamp(1.85rem,6vw,4.5rem)] cursor-default">
      {positionWords.map((w, i) => (
        <Fragment>{i > 0 && " "}<span class="glitch" data-text={w}>{w}</span></Fragment>
      ))}
    </h1>

    <!-- Name — small, below the position -->
    <p class="mt-4 font-mono text-xs md:text-sm uppercase tracking-[0.3em] text-muted">
      {profile.shortName}<span class="text-accent">.</span>
    </p>

    <!-- Tagline -->
    <p class="mt-7 max-w-3xl font-serif text-xl md:text-2xl lg:text-3xl leading-snug text-text/85">
      High-performance mobile apps for clients across three continents — built in&nbsp;
      <span
        class="inline-block text-accent italic"
        data-rotator
        data-rotator-items={JSON.stringify(rotators)}
        style="min-width: 7ch;"
      >Flutter</span>
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/work"
        class="btn-primary"
      >
        View work →
      </a>
      <a
        href="#contact"
        class="btn-outline"
      >
        Get in touch
      </a>
      <a
        href="/resume"
        class="btn-ghost"
      >
        Read resume
      </a>
    </div>

    <!-- Motion control — animations are OFF by default for a calm, legible
         first impression. A reviewer can switch on the full animated
         experience (the drone game + section FX) right here. Toggling reloads
         so every FX engine re-initialises from a clean state. -->
    <div class="mt-9">
      <button
        type="button"
        data-motion-toggle
        aria-pressed="false"
        aria-label="Play background animations"
        class="group inline-flex items-center gap-2.5 rounded-full border border-border bg-paper/50 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted transition-colors hover:border-accent/50 hover:text-accent"
      >
        <svg data-motion-icon="play" class="h-3 w-3 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg data-motion-icon="pause" class="hidden h-3 w-3 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
        </svg>
        <span data-motion-label>Play animations</span>
      </button>
    </div>
  </div>

  <!-- Bottom rule + scroll hint — anchored to the bottom of the viewport -->
  <div class="container-page pb-8">
    <div class="flex items-center gap-4">
      <div class="h-px flex-1 bg-border"></div>
      <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">↓ scroll · the rest of the story</span>
      <div class="h-px flex-1 bg-border"></div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const el = document.querySelector("[data-rotator]");
    if (!el) return;
    let items;
    try {
      items = JSON.parse(el.getAttribute("data-rotator-items") || "[]");
    } catch (e) {
      items = [];
    }
    if (!items.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("reduce-motion");
    if (reduceMotion) return;

    let i = 0;
    setInterval(() => {
      i = (i + 1) % items.length;
      el.style.opacity = "0";
      el.style.transform = "translateY(-4px)";
      el.style.transition = "opacity 220ms ease-out, transform 220ms ease-out";
      setTimeout(() => {
        el.textContent = items[i];
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      }, 240);
    }, 2600);
  })();
</script>

<!-- Motion toggle — flips the persisted preference and reloads so the FX
     engines (game, section canvases, glitch/scramble) re-init cleanly with the
     new state, rather than half-applying mid-session. -->
<script is:inline>
  (function () {
    const btn = document.querySelector("[data-motion-toggle]");
    if (!btn) return;
    const root = document.documentElement;
    const motionOn = !root.classList.contains("reduce-motion");
    const playIcon = btn.querySelector('[data-motion-icon="play"]');
    const pauseIcon = btn.querySelector('[data-motion-icon="pause"]');
    const label = btn.querySelector("[data-motion-label]");

    // Reflect the current state on load (default = off → "Play animations").
    btn.setAttribute("aria-pressed", motionOn ? "true" : "false");
    if (motionOn) {
      if (playIcon) playIcon.classList.add("hidden");
      if (pauseIcon) pauseIcon.classList.remove("hidden");
      if (label) label.textContent = "Pause animations";
      btn.setAttribute("aria-label", "Pause background animations");
    }

    btn.addEventListener("click", () => {
      try { localStorage.setItem("motion", motionOn ? "off" : "on"); } catch (e) {}
      location.reload();
    });
  })();
</script>
