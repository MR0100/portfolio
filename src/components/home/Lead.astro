---
import { profile } from "~/data/profile";
import CyberDrones from "~/components/CyberDrones.astro";

const positionWords = profile.headline.split(" ");
const rotators = ["Flutter", "Kotlin", "Swift", "Compose"];
---

<section data-game-host class="relative overflow-hidden flex min-h-[calc(100svh_-_4rem)] flex-col">
  <!-- The spacewar game lives ONLY in the hero, behind the text, and scrolls with it.
       The engine shuts off when the hero leaves the viewport. (The dot-grid is the
       parallaxing .grid-zone layer in index.astro, spanning the first three sections.) -->
  <CyberDrones />

  <!-- Main content — vertically centered in the viewport -->
  <div class="container-page flex flex-1 flex-col justify-center py-12">
    <!-- Top-left meta -->
    <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5 flicker">
        <span class="relative inline-flex h-2 w-2">
          <span class="absolute inset-0 rounded-full bg-accent/40 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        Available for senior roles
      </span>
      <span aria-hidden="true">·</span>
      <span>{profile.location}</span>
    </div>

    <!-- Position — the big headline, glitches per word -->
    <h1 class="mt-8 md:mt-10 font-display font-semibold tracking-tight leading-[1.05] text-[clamp(1.85rem,6vw,4.5rem)] cursor-default">
      {positionWords.map((w, i) => (
        <Fragment>{i > 0 && " "}<span class="glitch" data-text={w}>{w}</span></Fragment>
      ))}
    </h1>

    <!-- Name — small, below the position -->
    <p class="mt-4 font-mono text-xs md:text-sm uppercase tracking-[0.3em] text-muted">
      {profile.shortName}<span class="text-accent">.</span>
    </p>

    <!-- Tagline -->
    <p class="mt-7 max-w-3xl font-serif text-xl md:text-2xl lg:text-3xl leading-snug text-text/85">
      High-performance mobile apps for clients across three continents — built in&nbsp;
      <span
        class="inline-block text-accent italic"
        data-rotator
        data-rotator-items={JSON.stringify(rotators)}
        style="min-width: 7ch;"
      >Flutter</span>
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/work"
        class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-bg hover:bg-accent-hover transition-colors"
      >
        View work →
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-md border border-border bg-paper/60 px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-text hover:border-accent/40 hover:text-accent transition-colors"
      >
        Get in touch
      </a>
      <a
        href="/resume"
        class="inline-flex items-center gap-2 rounded-md px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-muted hover:text-accent transition-colors"
      >
        Read resume
      </a>
    </div>
  </div>

  <!-- Bottom rule + scroll hint — anchored to the bottom of the viewport -->
  <div class="container-page pb-8">
    <div class="flex items-center gap-4">
      <div class="h-px flex-1 bg-border"></div>
      <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted">↓ scroll · the rest of the story<span class="blink text-accent" aria-hidden="true">▋</span></span>
      <div class="h-px flex-1 bg-border"></div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const el = document.querySelector("[data-rotator]");
    if (!el) return;
    let items;
    try {
      items = JSON.parse(el.getAttribute("data-rotator-items") || "[]");
    } catch (e) {
      items = [];
    }
    if (!items.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return;

    let i = 0;
    setInterval(() => {
      i = (i + 1) % items.length;
      el.style.opacity = "0";
      el.style.transform = "translateY(-4px)";
      el.style.transition = "opacity 220ms ease-out, transform 220ms ease-out";
      setTimeout(() => {
        el.textContent = items[i];
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      }, 240);
    }, 2600);
  })();
</script>
