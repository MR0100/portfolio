---
import { getCollection } from "astro:content";
import { experience, profile } from "~/data/profile";

const all = await getCollection("work");
const current = experience[0];

// Apps currently shipping at the current employer — derived, links to case studies.
const shipping = all
  .filter((e) => e.data.employer === current.company)
  .sort((a, b) => a.data.order - b.data.order);

// Single source of truth in profile.ts.
const learningList = profile.currentlyLearning;
---

<section class="container-page section-y">
  <!-- Glassmorphic status console — translucent base + backdrop-blur + top
       highlight sheen + soft accent glow. Sits beautifully on the dot-grid
       backdrop without competing with it. -->
  <div class="hud glass-card relative overflow-hidden rounded-xl">
    <!-- Top sheen highlight — runs along the top edge to suggest glass curvature -->
    <div class="glass-sheen" aria-hidden="true"></div>
    <!-- Inner border highlight — gives the card a crisp outline against any bg -->
    <div class="glass-rim" aria-hidden="true"></div>

    <!-- Console header -->
    <div class="relative z-10 flex items-center justify-between gap-3 border-b border-border dark:border-white/[0.04] px-4 py-2.5">
      <div class="flex items-center gap-2.5 font-mono text-[10px] uppercase tracking-[0.24em] text-muted">
        <span class="text-accent">◢</span>
        <span class="text-text">status</span>
        <span aria-hidden="true">·</span>
        <span>now</span>
      </div>
      <div class="flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
        <!-- signal strength -->
        <span class="eq" aria-hidden="true" title="Signal: strong">
          <i></i><i></i><i></i><i></i>
        </span>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <!-- live clock (IST) -->
        <span class="inline-flex items-center gap-1.5" aria-hidden="true">
          <span class="relative inline-flex h-1.5 w-1.5">
            <span class="absolute inset-0 rounded-full bg-accent/40 animate-ping"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
          </span>
          <span data-clock class="tabular-nums text-text">--:--:--</span>
          <span>IST</span>
        </span>
      </div>
    </div>

    <!-- Channels -->
    <dl class="relative z-10 divide-y divide-border dark:divide-white/[0.04]">
      <!-- 01 · Currently -->
      <div class="grid grid-cols-[28px_1fr] md:grid-cols-[28px_140px_1fr_auto] items-baseline gap-x-4 gap-y-1 px-4 py-5 md:py-6">
        <span class="font-mono text-[11px] tabular-nums text-accent">01</span>
        <dt class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted col-start-2 md:col-start-2">Currently</dt>
        <dd class="col-span-2 md:col-span-1 md:col-start-3 space-y-0.5">
          <div class="font-display text-xl md:text-2xl font-semibold tracking-tight leading-tight">{current.title}</div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{current.company} · Surat, IN</div>
        </dd>
        <dd class="col-start-2 md:col-start-4 md:justify-self-end">
          <span class="status-pill status-pill--active">
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inset-0 rounded-full bg-[rgb(var(--status-active)_/_0.45)] animate-ping"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[rgb(var(--status-active))]"></span>
            </span>
            Active
          </span>
        </dd>
      </div>

      <!-- 02 · Shipping -->
      <div class="grid grid-cols-[28px_1fr] md:grid-cols-[28px_140px_1fr_auto] items-baseline gap-x-4 gap-y-1 px-4 py-5 md:py-6">
        <span class="font-mono text-[11px] tabular-nums text-accent">02</span>
        <dt class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted col-start-2 md:col-start-2">Shipping</dt>
        <dd class="col-span-2 md:col-span-1 md:col-start-3 space-y-1">
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
            {shipping.map((e, i) => (
              <>
                <a
                  href={`/work/${e.slug}`}
                  class="font-display text-xl md:text-2xl font-semibold tracking-tight leading-tight hover:text-accent transition-colors"
                >{e.data.title}</a>
                {i < shipping.length - 1 && <span class="text-muted" aria-hidden="true">·</span>}
              </>
            ))}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Live in app stores · iOS + Android</div>
        </dd>
        <dd class="col-start-2 md:col-start-4 md:justify-self-end">
          <span class="status-pill status-pill--active">
            <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            Deployed
          </span>
        </dd>
      </div>

      <!-- 03 · Learning -->
      <div class="grid grid-cols-[28px_1fr] md:grid-cols-[28px_140px_1fr_auto] items-baseline gap-x-4 gap-y-1 px-4 py-5 md:py-6">
        <span class="font-mono text-[11px] tabular-nums text-accent">03</span>
        <dt class="font-mono text-[10px] uppercase tracking-[0.24em] text-muted col-start-2 md:col-start-2">Learning</dt>
        <dd class="col-span-2 md:col-span-1 md:col-start-3 space-y-1">
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
            {learningList.map((s, i) => (
              <>
                <span class="font-display text-xl md:text-2xl font-semibold tracking-tight leading-tight">{s}</span>
                {i < learningList.length - 1 && <span class="text-muted" aria-hidden="true">/</span>}
              </>
            ))}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Always something on the bench</div>
        </dd>
        <dd class="col-start-2 md:col-start-4 md:justify-self-end">
          <span class="status-pill status-pill--progress">
            <span class="inline-flex h-1.5 w-1.5 rounded-full bg-[rgb(var(--status-progress))]"></span>
            In progress
          </span>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* ──────────── Frosted glass + glossy gleam ────────────
     A thin, very-translucent panel with heavy blur — backdrop visibly
     bleeds through the surface. A diagonal sheen sweeps top-left to
     bottom-right to mimic light reflecting across polished glass.
     Mode-aware via global selectors. */
  .glass-card {
    /* Frosted glass — moderate 4px blur for a clear "behind glass" feel
       while keeping dots visible as softened points. Surface gets a
       VERY light accent-soft tint in light mode so the card edge reads
       against the bluish-white page bg (which otherwise blends). Drop
       shadow tinted with the theme accent for a blueish lift instead
       of grey weight. */
    background: linear-gradient(
      180deg,
      rgb(var(--accent) / 0.05) 0%,
      rgb(var(--accent) / 0.02) 100%
    );
    -webkit-backdrop-filter: blur(4px) saturate(120%);
    backdrop-filter: blur(4px) saturate(120%);
    box-shadow:
      0 14px 28px -14px rgb(var(--accent) / 0.10),
      0 4px 10px -6px rgb(var(--accent) / 0.06);
  }
  :global(.dark) .glass-card {
    /* Dark mode — no tint needed, the dot grid + dark bg give the
       card its own contrast. Shadow is the accent blue at low alpha
       so it just suggests depth without halo-ing the card. */
    background: transparent;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    box-shadow:
      0 16px 32px -16px rgb(var(--accent) / 0.12),
      0 5px 12px -6px rgb(var(--accent) / 0.07);
  }

  /* ── Sheen — accent-tinted top wash only.
        Was white at low alpha; switched to accent so the upper edge
        picks up the theme blue family instead of looking grey. */
  .glass-sheen {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(var(--accent) / 0.08) 0%,
      rgb(var(--accent) / 0.02) 25%,
      transparent 55%
    );
  }
  :global(.dark) .glass-sheen {
    background: linear-gradient(
      180deg,
      rgb(var(--accent) / 0.06) 0%,
      rgb(var(--accent) / 0.015) 25%,
      transparent 55%
    );
  }

  /* ── Rim — quiet hairline outline only.
        Removed the bright top highlight + dark bottom shadow because
        they were reading as "shiny edge". Just a soft 1px stroke at
        very low alpha so the card has a clean boundary. */
  .glass-rim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    /* Theme-accent tinted border — picks up the blue family instead of
       the off-white rim that read as a "grey edge". Stronger in light
       mode where the card sits on a bluish-white bg and needs visible
       definition. */
    border: 1px solid rgb(var(--accent) / 0.22);
  }
  :global(.dark) .glass-rim {
    border-color: rgb(var(--accent) / 0.20);
  }
</style>

<script is:inline>
  (function () {
    const el = document.querySelector("[data-clock]");
    if (!el) return;
    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Kolkata",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    const tick = () => {
      try {
        el.textContent = fmt.format(new Date());
      } catch (e) {}
    };
    tick();
    setInterval(tick, 1000);
  })();
</script>
