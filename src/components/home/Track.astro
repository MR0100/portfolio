---
import { experience } from "~/data/profile";
import SectionFX from "~/components/SectionFX.astro";
---

<section class="relative" data-track>
  <SectionFX variant="dots" />
  <div class="container-page py-20 md:py-28 relative z-10">
    <div class="grid gap-10 lg:grid-cols-[280px_1fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start space-y-3">
      <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-sepia">The track record</div>
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05]" data-scramble>
        Two companies, six years, one craft.
      </h2>
      <a href="/resume" class="inline-block font-mono text-xs uppercase tracking-[0.24em] text-accent hover:text-accent-hover transition-colors">
        Full resume →
      </a>
    </div>

    <ol class="space-y-12">
      {
        experience.map((role, i) => (
          <li class="relative border-l border-border pl-7">
            <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-bg" />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-xl md:text-2xl font-semibold tracking-tight">{role.title}</h3>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent">{role.period}</span>
            </div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
              {role.company} · {role.location}
            </div>
            <p class="mt-3 font-serif text-base md:text-lg text-text/85 leading-relaxed max-w-prose">
              {role.highlights[0]}
            </p>
            {role.highlights.length > 1 && (
              <p class="mt-2 font-serif text-base text-muted leading-relaxed max-w-prose">
                {role.highlights[1]}
              </p>
            )}
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>
