---
import { profile } from "~/data/profile";

const openTo = ["Senior IC", "Mobile Lead", "Architecture"];
const linkedinHandle = "mitul-vaghasiya";
const githubHandle = "MR0100";
const twitterHandle = "@_MR_0100";
---

<!-- ═════════════════ Contact section ═════════════════
     Two-column layout (single-column on mobile):
       LEFT  — pitch, primary email card, secondary channels.
       RIGHT — "live status" card: availability pulse, open-to chips,
               notice period, location + live IST clock, reply window.
     Transparent backdrop — sits flat on the page bg like the rest of
     the site sections do post-toolkit-revert. -->
<section id="contact" class="relative section-y">
  <div class="container-page">
    <div class="grid lg:grid-cols-[1.35fr_1fr] gap-12 lg:gap-16 max-w-6xl mx-auto">

      <!-- ═════════════ LEFT: Pitch + actions ═════════════ -->
      <div class="space-y-7">
        <div class="eyebrow">
          Let's build something
        </div>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.02]" data-scramble>
          Got a hard mobile problem?
        </h2>
        <p class="font-serif text-lg md:text-xl text-text/85 leading-snug max-w-xl">
          Open to senior IC, lead, and architecture roles — full-time or contract.
          Email is the fastest way to reach me; I read everything.
        </p>

        <!-- Primary email card — full-bleed clickable card with icon, label, value, arrow.
             Hover lifts the border to accent. The whole card is one anchor so the
             encryption hover effect can run on the inner email text. -->
        <a
          href={profile.socials.email}
          class="group block rounded-xl border border-border bg-paper/40 backdrop-blur-sm hover:border-accent/60 hover:bg-paper/60 transition-colors overflow-hidden"
        >
          <div class="flex items-stretch">
            <div class="flex items-center justify-center px-5 bg-accent/10 border-r border-border group-hover:border-accent/40 transition-colors">
              <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7l9 6 9-6"/>
                <rect x="3" y="5" width="18" height="14" rx="2"/>
              </svg>
            </div>
            <div class="flex-1 px-5 py-4 min-w-0">
              <div class="font-mono text-[9.5px] uppercase tracking-[0.22em] text-sepia mb-1">
                Send an email
              </div>
              <div class="font-display text-base md:text-lg font-semibold text-text truncate">
                {profile.email}
              </div>
            </div>
            <div class="flex items-center justify-center px-5 text-muted group-hover:text-accent group-hover:translate-x-0.5 transition-all">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>

        <!-- Secondary channels — three small cards in a row, each with handle.
             They read as "alternate paths" without competing with the email CTA. -->
        <div class="grid sm:grid-cols-3 gap-3 pt-1">
          <a
            href={profile.socials.linkedin}
            target="_blank"
            rel="noreferrer noopener"
            class="group flex items-center gap-3 rounded-lg border border-border bg-paper/30 backdrop-blur-sm hover:border-accent/40 hover:bg-paper/60 px-4 py-3 transition-colors"
          >
            <svg class="h-4 w-4 text-muted group-hover:text-accent transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.55v-5.56c0-1.33-.03-3.03-1.85-3.03-1.85 0-2.13 1.45-2.13 2.94v5.65H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45z"/>
            </svg>
            <div class="min-w-0">
              <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-sepia">LinkedIn</div>
              <div class="font-mono text-[11px] text-text truncate">{linkedinHandle}</div>
            </div>
          </a>

          <a
            href={profile.socials.github}
            target="_blank"
            rel="noreferrer noopener"
            class="group flex items-center gap-3 rounded-lg border border-border bg-paper/30 backdrop-blur-sm hover:border-accent/40 hover:bg-paper/60 px-4 py-3 transition-colors"
          >
            <svg class="h-4 w-4 text-muted group-hover:text-accent transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55 0-.27-.01-1-.02-1.96-3.2.69-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.19 1.18a11.1 11.1 0 0 1 5.81 0c2.22-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.12 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.66.8.55C20.22 21.38 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            <div class="min-w-0">
              <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-sepia">GitHub</div>
              <div class="font-mono text-[11px] text-text truncate">{githubHandle}</div>
            </div>
          </a>

          <a
            href={profile.socials.twitter}
            target="_blank"
            rel="noreferrer noopener"
            class="group flex items-center gap-3 rounded-lg border border-border bg-paper/30 backdrop-blur-sm hover:border-accent/40 hover:bg-paper/60 px-4 py-3 transition-colors"
          >
            <svg class="h-4 w-4 text-muted group-hover:text-accent transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
            </svg>
            <div class="min-w-0">
              <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-sepia">X / Twitter</div>
              <div class="font-mono text-[11px] text-text truncate">{twitterHandle}</div>
            </div>
          </a>
        </div>
      </div>

      <!-- ═════════════ RIGHT: Live status card ═════════════ -->
      <aside class="relative">
        <div class="relative rounded-xl border border-border bg-paper/40 backdrop-blur-sm overflow-hidden">
          <!-- Status header -->
          <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-border/70 bg-bg/30">
            <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.22em]">
              <span class="text-accent">◢</span>
              <span class="text-text">Status</span>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.2em] text-accent">
              <span class="relative inline-flex h-1.5 w-1.5">
                <span class="absolute inset-0 rounded-full bg-accent/40 animate-ping"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
              </span>
              Available
            </span>
          </div>

          <!-- Status body — facts list -->
          <dl class="px-5 py-4 divide-y divide-border/50">
            <!-- Open to -->
            <div class="py-3 first:pt-0">
              <dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-sepia mb-2">Open to</dt>
              <dd class="flex flex-wrap gap-1.5">
                {openTo.map((role) => (
                  <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-[11px] font-medium text-accent">
                    {role}
                  </span>
                ))}
              </dd>
            </div>

            <!-- Format -->
            <div class="py-3 grid grid-cols-2 gap-3">
              <div>
                <dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-sepia mb-1">Format</dt>
                <dd class="font-sans text-[13px] font-medium text-text">Full-time · Contract</dd>
              </div>
              <div>
                <dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-sepia mb-1">Notice</dt>
                <dd class="font-sans text-[13px] font-medium text-text tabular-nums">{profile.noticePeriod}</dd>
              </div>
            </div>

            <!-- Location + live IST clock -->
            <div class="py-3">
              <dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-sepia mb-1">Based · Local time</dt>
              <dd class="flex items-baseline justify-between gap-3">
                <span class="font-sans text-[13px] font-medium text-text">{profile.location}</span>
                <span class="font-mono text-[11px] text-muted tabular-nums" aria-hidden="true">
                  <span data-contact-clock>--:--:--</span> IST
                </span>
              </dd>
            </div>

            <!-- Reply time -->
            <div class="py-3">
              <dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-sepia mb-1">Reply window</dt>
              <dd class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 text-accent flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span class="font-sans text-[13px] font-medium text-text">Within 1–2 days</span>
              </dd>
            </div>

            <!-- Languages -->
            <div class="py-3 last:pb-0">
              <dt class="font-mono text-[9px] uppercase tracking-[0.22em] text-sepia mb-1">Languages</dt>
              <dd class="font-sans text-[13px] font-medium text-text">{profile.languagesSpoken.join(" · ")}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>

<script is:inline>
  // Live IST clock — same pattern as the home Status console.
  (function () {
    const el = document.querySelector("[data-contact-clock]");
    if (!el) return;
    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Kolkata",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    const tick = () => {
      try { el.textContent = fmt.format(new Date()); } catch (e) {}
    };
    tick();
    setInterval(tick, 1000);
  })();
</script>
