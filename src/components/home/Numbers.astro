---
import { getCollection } from "astro:content";
import SectionFX from "~/components/SectionFX.astro";

const all = await getCollection("work");

const verified = all.filter((e) => e.data.status === "verified").length;
const industries = new Set(all.map((e) => e.data.category)).size;
const cities = new Set(
  all.filter((e) => e.data.city).map((e) => `${e.data.city},${e.data.country}`),
).size;

const continentMap: Record<string, string> = {
  "South Asia": "Asia",
  "East Asia": "Asia",
  "Southeast Asia": "Asia",
  "North America": "North America",
  "South America": "South America",
  "Europe": "Europe",
};
const continents = new Set(
  all.map((e) => continentMap[e.data.region]).filter(Boolean),
).size;

// Lead with the most verifiable claim (`verified`). Cities + continents fold into one tile.
const stats = [
  { to: verified, suffix: "", l: "Live in app stores", s: "Verified listings" },
  { to: cities, suffix: "", l: "Cities served", s: `Across ${continents} continents` },
  { to: all.length, suffix: "", l: "Apps shipped", s: "Cross-platform & native" },
  { to: 6, suffix: "+", l: "Years in the field", s: "Jr. → Lead" },
  { to: industries, suffix: "", l: "Industries", s: "Diamonds → health → agtech" },
];
---

<section class="numbers-section relative overflow-hidden border-y border-border" data-numbers style="--sfx-opacity: 0.18;">
  <!-- Atmospheric gradients — accent glow top-left + accent-soft balance bottom-right -->
  <div class="numbers-gradient" aria-hidden="true"></div>
  <SectionFX variant="hex" />
  <div class="container-page py-14 md:py-20 relative z-10">
    <div class="flex items-center gap-2.5 font-mono text-[10px] uppercase tracking-[0.24em] text-sepia mb-10">
      <span>By the numbers</span>
    </div>

    <dl class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-5 md:gap-8">
      {
        stats.map((s) => (
          <div class="space-y-2">
            <dd class="font-display text-5xl md:text-7xl font-semibold tracking-tight tabular-nums leading-none text-accent">
              <span class="inline-block glitch" data-countup data-to={s.to} data-suffix={s.suffix}>{s.to}{s.suffix}</span>
            </dd>
            <dt class="font-display text-base font-semibold tracking-tight">{s.l}</dt>
            <dd class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{s.s}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* Solid paper base hides the page-level dot grid behind this section.
     The gradient layer adds atmospheric depth without breaking opacity. */
  .numbers-section {
    background: rgb(var(--paper));
  }
  .numbers-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      /* Accent glow — top-left corner */
      radial-gradient(ellipse 60% 80% at 0% 0%, rgb(var(--accent) / 0.14), transparent 65%),
      /* Accent-soft balance — bottom-right corner */
      radial-gradient(ellipse 70% 70% at 100% 100%, rgb(var(--accent-soft) / 0.18), transparent 60%),
      /* Centre breathing wash */
      radial-gradient(ellipse 90% 60% at 50% 50%, rgb(var(--accent) / 0.04), transparent 80%);
  }
</style>

<!-- Count-up on scroll, then a subtle glitch on each number at random intervals (3–15s).
     Scoped to this section, IntersectionObserver-driven, reduced-motion safe. -->
<script is:inline>
  (function () {
    const root = document.querySelector("[data-numbers]");
    if (!root) return;
    const rm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nums = root.querySelectorAll("[data-countup]");

    const finalText = (el) =>
      (el.getAttribute("data-to") || "") + (el.getAttribute("data-suffix") || "");

    // One brief glitch: chromatic split (CSS) + a quick digit scramble that resolves.
    const glitchOnce = (el) => {
      const to = el.getAttribute("data-to") || "";
      const suffix = el.getAttribute("data-suffix") || "";
      el.setAttribute("data-text", to + suffix); // for the RGB-split slice layers
      el.classList.add("glitch-auto");
      const scramble = () => {
        let s = "";
        for (const ch of to) {
          s += ch >= "0" && ch <= "9" ? String(Math.floor(Math.random() * 10)) : ch;
        }
        el.textContent = s + suffix;
      };
      scramble();
      setTimeout(scramble, 80);
      setTimeout(() => { el.textContent = to + suffix; }, 170);
      setTimeout(() => { el.classList.remove("glitch-auto"); }, 480);
    };

    // Each number schedules its own next glitch at a random delay, capped at 15s.
    const scheduleGlitch = (el) => {
      if (rm) return;
      const delay = 3000 + Math.random() * 12000; // 3s … 15s
      setTimeout(() => {
        glitchOnce(el);
        scheduleGlitch(el);
      }, delay);
    };

    const countUp = (el) => {
      const to = parseFloat(el.getAttribute("data-to") || "0");
      const suffix = el.getAttribute("data-suffix") || "";
      const dur = 1100;
      const start = performance.now();
      const step = (now) => {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(eased * to) + suffix;
        if (p < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = finalText(el);
          scheduleGlitch(el);
        }
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target;
          io.unobserve(el);
          if (rm) { el.textContent = finalText(el); return; }
          countUp(el);
        });
      },
      { threshold: 0.4 }
    );

    nums.forEach((el) => {
      if (!rm) el.textContent = "0" + (el.getAttribute("data-suffix") || "");
      io.observe(el);
    });
  })();
</script>
