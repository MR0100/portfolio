---
import { getCollection } from "astro:content";
import WorldMap from "~/components/WorldMap.astro";

const all = await getCollection("work");

// Build a city roster from located projects.
type Hub = { city: string; country: string; count: number; note: string };
const noteByCity: Record<string, string> = {
  Surat: "Enterprise, e-commerce & creative tooling",
  Toronto: "AgTech — crop monitoring at field scale",
  Tokyo: "Ed-tech — synchronised group study",
  Seoul: "Three consumer lifestyle apps",
  Berlin: "Telehealth — video-led rehab",
};

const hubs = new Map<string, Hub>();
for (const e of all) {
  if (!e.data.city) continue;
  const key = e.data.city;
  if (!hubs.has(key)) {
    hubs.set(key, {
      city: e.data.city,
      country: e.data.country ?? "",
      count: 0,
      note: noteByCity[e.data.city] ?? "",
    });
  }
  hubs.get(key)!.count++;
}
const roster = Array.from(hubs.values()).sort((a, b) => b.count - a.count);
---

<section class="container-page py-12 md:py-16">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div class="space-y-1.5">
      <div class="font-mono text-[10px] uppercase tracking-[0.24em] text-sepia">Where the work shipped</div>
      <h2 class="font-display text-2xl md:text-4xl font-semibold tracking-tight leading-[1.05] max-w-2xl" data-scramble>
        An atlas of mobile engineering.
      </h2>
    </div>
    <a href="/work" class="font-mono text-xs uppercase tracking-[0.24em] text-accent hover:text-accent-hover transition-colors">
      Full catalog →
    </a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1.6fr_1fr] lg:gap-10 lg:items-center">
    <div class="hud border border-border bg-paper/40 rounded-lg p-2 md:p-3">
      <WorldMap />
    </div>

    <ol class="divide-y divide-border/60 border-y border-border/60">
      {
        roster.map((h, i) => (
          <li class="flex items-baseline gap-3 py-2.5">
            <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-accent tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-display text-base font-semibold tracking-tight">{h.city}</span>
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{h.country}</span>
              </div>
              {h.note && <p class="mt-0.5 font-serif text-[13px] text-muted leading-snug">{h.note}</p>}
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted whitespace-nowrap">
              {h.count} {h.count === 1 ? "app" : "apps"}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
