# ── Privacy-friendly analytics (optional) ──
# Cookieless, no-PII page analytics via Plausible. Leave unset to disable.
# Set to your verified domain to turn it on (copy this file to `.env`):
# PUBLIC_PLAUSIBLE_DOMAIN=mitulvaghasiya.com
#
# Optional — point at a self-hosted Plausible/Umami-compatible instance
# instead of the hosted plausible.io:
# PUBLIC_PLAUSIBLE_HOST=https://analytics.example.com
